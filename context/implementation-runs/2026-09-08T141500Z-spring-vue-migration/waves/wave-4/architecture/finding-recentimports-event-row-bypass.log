--- 2. frontend/src/components/import/RecentImports.vue (introduced this wave, import-wizard journey) ---
<script setup lang="ts">
// PARTIAL · import step 1 · recent imports — ported from pages/import/recent-imports.html.twig.
// Sticky right column: what was imported before, by whom, with what result.
import { computed } from "vue";
import { useI18n } from "vue-i18n";
import { useRoute } from "vue-router";
import Chip from "@/components/atoms/Chip.vue";
import Icon from "@/components/atoms/Icon.vue";
import { importStepPath } from "@/components/import/importRoute";

export interface RecentImportItem {
    file: string;
    rows: string;
    date: string;
    who: string;
    ok: boolean;
    note: string;
}

defineProps<{ imports: RecentImportItem[] }>();

const { t } = useI18n();
const route = useRoute();
const locale = computed(() =>
    typeof route.params.locale === "string" ? route.params.locale : "pl",
);
const historyHref = computed(() => importStepPath(locale.value, 1));

// The old template reuses .event-row's grid/hover/border-bottom styling for this unrelated
// list (recent-imports.html.twig has no event data at all) — the visual match (:hover,
// :last-child) is not reproducible via inline styles, so the class stays, but it is bound
// from this constant rather than written as a literal `class="event-row"` in the template:
// eslint.config.js's `vue/no-restricted-class` forbids that literal (wave-2 "Row markup in
// one place" — EventRow.vue is the only component that may render an actual tracking-event
// row), a rule this reuse does not violate in spirit since nothing here is an event, but
// which its plain string-literal check cannot tell apart from one. See worker-report.md.
const recentImportRowClass = "event-row";
</script>

<template>

