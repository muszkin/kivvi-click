  "event-stream": {
    "title": "The store owner can watch tracked events arrive live, filter the log, and a replayed event is never shown twice",
    "spec": "tests/e2e/specs/events.spec.ts, tests/Tracking/EventIngestionTest.php",
    "steps": [
      {
        "goto": "/pl/events",
        "waitAttr": [
          "#event-stream",
          "data-stream-state",
          "live"
        ]
      },
      {
        "post": "/collect",
        "json": {
          "idempotency_id": "oracle-evt-__RUN__",
          "type": "purchase",
          "detail": "412,00 PLN · zamówienie ORACLE-__RUN__",
          "customer_id": "c_1001",
          "customer_name": "Hania Kowalska",
          "site": "aureashop.pl"
        },
        "expectStatus": 202,
        "waitText": [
          "#event-stream .event-row",
          "ORACLE-__RUN__"
        ]
      },
      {
        "post": "/collect",
        "json": {
          "idempotency_id": "oracle-evt-__RUN__",
          "type": "purchase",
          "detail": "412,00 PLN · zamówienie ORACLE-__RUN__",
          "customer_id": "c_1001",
          "customer_name": "Hania Kowalska",
          "site": "aureashop.pl"
        },
        "expectStatus": 200,
        "note": "duplicate idempotency id"
      },
      {
        "post": "/collect",
        "json": {
          "type": "purchase"
        },
        "expectStatus": 400,
        "note": "missing idempotency id"
      },
      {
        "post": "/collect",
        "json": {
          "idempotency_id": "oracle-bad-__RUN__",
          "type": "teleport"
        },
        "expectStatus": 400,
        "note": "unknown type"
      },
      {
        "click": "[data-action=\"pause-stream\"]",
        "waitAttr": [
          "#event-stream",
          "data-paused",
          "true"
        ]
      },
      {
        "goto": "/pl/events?type=purchase&site=aurea&range=24h"
      }
    ]
  },
  "dashboard": {
    "title": "The store owner can see the operational overview and jump from it into a customer profile or a rule",
    "spec": "tests/e2e/specs/dashboard.spec.ts, tests/Controller/PanelPagesTest.php (dashboard)",
