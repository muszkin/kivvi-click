{
  "login": {
    "title": "The store owner can sign in with an e-mail address and see their identity in the panel shell",
    "spec": "tests/e2e/specs/public.spec.ts (login), tests/Controller/SecurityControllerTest.php",
    "steps": [
      {
        "goto": "/pl/login"
      },
      {
        "fill": "#f-_username",
        "value": "anna@aureashop.pl"
      },
      {
        "fill": "#f-_password",
        "value": "haslo-testowe"
      },
      {
        "click": "button[type=\"submit\"]",
        "waitUrl": "/pl/dashboard"
      },
      {
        "post": "/pl/login",
        "form": {
          "_username": "",
          "_password": ""
        },
        "note": "empty e-mail rejected server-side"
      },
      {
        "post": "/pl/login",
        "form": {
          "_username": "not-an-email"
        },
        "note": "malformed e-mail rejected server-side"
      },
      {
        "post": "/pl/logout",
        "form": {},
        "note": "sign-out restores default identity"
      },
      {
        "goto": "/pl/dashboard"
      }
    ]
  },
