{"kind":"api","method":"POST","path":"/pl/login","request":{"form":{"_username":"not-an-email"}},"status":200,"headers":{"cache-control":"max-age=0, must-revalidate, private","content-encoding":"br","content-type":"text/html; charset=UTF-8","expires":"Tue, 08 Sep 2026 13:51:05 GMT","permissions-policy":"browsing-topics=()","transfer-encoding":"chunked","vary":"Accept-Encoding","x-robots-tag":"noindex"},"body":"<!doctype html>\n<html lang=\"pl\" data-theme=\"light\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Wróć do Kivvi — kivvi·click</title>\n    <link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg%20width%3D%2245%22%20height%3D%2232%22%20viewBox%3D%220%200%2056%2040%22%20aria-hidden%3D%22true%22%3E%0A%20%20%3Cellipse%20cx%3D%2234%22%20cy%3D%2224%22%20rx%3D%2218%22%20ry%3D%2214%22%20fill%3D%22currentColor%22%2F%3E%0A%20%20%3Cpolygon%20points%3D%2216%2C25%20-2%2C21%2016%2C29%22%20fill%3D%22currentColor%22%2F%3E%0A%20%20%3Ccircle%20cx%3D%2240%22%20cy%3D%2220%22%20r%3D%221.8%22%20fill%3D%22var%28--bg-card%29%22%2F%3E%3C%2Fsvg%3E\">\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap\">\n      <link rel=\"stylesheet\" href=\"/assets/styles/app-opJw04T.css\">\n  </head>\n<body>\n  <div class=\"auth-wrap\">\n  <div class=\"auth-side\">\n    <div class=\"row\" style=\"gap: 10px;\">\n  <span style=\"color: var(--accent); display: inline-flex; align-items: center;\">\n    <svg width=\"39\" height=\"28\" viewBox=\"0 0 56 40\" aria-hidden=\"true\">\n  <ellipse cx=\"34\" cy=\"24\" rx=\"18\" ry=\"14\" fill=\"currentColor\"/>\n  <polygon points=\"16,25 -2,21 16,29\" fill=\"var(--brown)\"/>\n  <circle cx=\"40\" cy=\"20\" r=\"1.8\" fill=\"var(--bg-card)\"/>  <circle cx=\"40.4\" cy=\"19.7\" r=\"0.7\" fill=\"currentColor\"/>\n  <rect x=\"28\" y=\"36\" width=\"1.6\" height=\"4\" rx=\"0.6\" fill=\"var(--brown)\"/>\n  <rect x=\"36\" y=\"36\" width=\"1.6\" height=\"4\" rx=\"0.6\" fill=\"var(--brown)\"/>\n  <circle cx=\"48\" cy=\"13\" r=\"2.2\" fill=\"var(--accent)\"/></svg>\n\n  </span>\n  <span class=\"brand-name\" style=\"font-size: 24px;\">kivvi<span class=\"brand-dot\"></span>click</span>\n</div>\n\n    <div>\n      <div class=\"mono\" style=\"font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--fg-muted); margin-bottom: 12px;\">\n        MARKETING AUTOMATION\n      </div>\n      <h1 style=\"font-family: var(--font-display); font-style: italic; font-size: 56px; line-height: 1.12; letter-spacing: -0.025em; margin: 0; padding-bottom: 0.15em;\">\n        Widzisz.<br><span style=\"color: var(--accent);\">Decydujesz.</span><br><span style=\"color: var(--brown);\">Działasz</span> w czasie rzeczywistym.\n      </h1>\n      <p class=\"muted\" style=\"font-size: 16px; max-width: 360px; margin-top: 18px;\">Śledź zachowanie odwiedzających i automatycznie uruchamiaj e-maile, popupy, kupony i rekomendacje w odpowiednim momencie ścieżki zakupowej.</p>\n    </div>\n    <div class=\"row\" style=\"gap: 14px; font-size: 13px; color: var(--fg-muted);\">\n      <span>© 2026 kivvi-click</span><span>·</span><a href=\"#\">Status</a><span>·</span><a href=\"#\">Dokumentacja</a>\n    </div>\n  </div>\n  <div class=\"auth-form\">\n    <div class=\"form\">  <h1>Wróć do Kivvi</h1>\n  <p class=\"sub\">Zaloguj się do panelu zarządzania automatyzacjami.</p>\n\n  <form method=\"post\">\n    <div class=\"field-row\"><label class=\"label\" for=\"f-_username\">Email</label>    <input class=\"input \" id=\"f-_username\" name=\"_username\" type=\"email\"\n           value=\"not-an-email\" placeholder=\"\"\n           ></div>\n\n    <div class=\"field-row\"><label class=\"label\" for=\"f-_password\">Hasło</label>    <input class=\"input \" id=\"f-_password\" name=\"_password\" type=\"password\"\n           value=\"\" placeholder=\"\"\n           ></div>\n\n\n          <div class=\"feed-card__err\">\n  <svg class=\"icon \"     viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"\n     stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" y1=\"16\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"8\" x2=\"12.01\" y2=\"8\"/></svg>\n  <span>To nie wygląda na poprawny adres e-mail.</span></div>\n\n    \n    <button class=\"btn primary lg\" type=\"submit\" style=\"width: 100%; justify-content: center; margi…"}
