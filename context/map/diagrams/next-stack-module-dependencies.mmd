%% Next-stack module dependencies — Spring Boot API (backend/) + Vue 3 SPA (frontend/)
%% (static, observed from backend/src/main/java, frontend/src, mercure/Caddyfile)
%% Legend: solid = observed static edge; dotted = inferred / external
flowchart LR
  subgraph browser["Browser (frontend/src)"]
    router["router/index.ts + routes.ts"]
    shellstore["stores/shell.ts (Pinia)"]
    intents["composables/useIntents.ts"]
    eventstream["composables/useEventStream.ts"]
    views["views/*View.vue"]
    components["components/{atoms,molecules,organisms}"]
    i18n["i18n/index.ts (canonical loader)"]
  end
  subgraph edge["mercure/ (edge, Caddy + Mercure hub)"]
    hub["Mercure hub /.well-known/mercure"]
    rproxy["reverse_proxy api:8080"]
  end
  subgraph web["backend web/ (Spring MVC controllers)"]
    spadoc["SpaDocumentController"]
    shellctrl["ShellController"]
    pagectrls["Page controllers (Dashboard, Events, Customers, Automations, Campaigns, Feeds, Import, Settings, Widget, Landing)"]
    collectctrl["CollectController"]
    loginctrl["LoginController"]
    prefsctrl["PreferencesController"]
    uploadctrl["ImportUploadController"]
  end
  subgraph application["backend application/"]
    viewservices["*ViewService (one per page)"]
    ingestsvc["tracking/EventIngestionService"]
    loginsvc["LoginService"]
    prefssvc["PreferencesService"]
    uploadsvc["ImportUploadService"]
  end
  subgraph domain["backend domain/"]
    routetable["RouteTable"]
    format["Format"]
    trackedevent["tracking/TrackedEvent"]
    eventtopic["tracking/EventStreamTopic"]
  end
  subgraph fixtures["backend fixtures/"]
    fixtureclasses["*Fixtures.java (sample data, Java records — R20)"]
  end
  subgraph infra["backend infrastructure/"]
    session["session/SessionRequestSerializationFilter + SpringSessionJDBC"]
    scheduling["scheduling/HeartbeatJob + ShedLock"]
    mercurepub["mercure/HttpMercurePublisher"]
    dedup["tracking/EventDedupStore"]
    importstore["importing/ImportUploadStorage"]
  end
  subgraph pg["Postgres (compose.next.yaml database)"]
    springsession["spring_session / spring_session_attributes"]
    shedlock["shedlock"]
    eventdedup["event_dedup"]
  end

  router --> views
  views --> components
  views --> intents
  views --> shellstore
  intents --> shellstore
  views --> eventstream
  eventstream --> hub
  views --> i18n
  shellstore -->|"GET /api/v1/{locale}/shell"| rproxy
  views -->|"GET /api/v1/{locale}/<page>"| rproxy
  intents -->|"navigate (real GET, never router.push)"| rproxy
  shellstore -->|"POST /preferences/theme|sidebar (keepalive)"| rproxy
  rproxy --> spadoc
  rproxy --> shellctrl
  rproxy --> pagectrls
  rproxy --> collectctrl
  rproxy --> loginctrl
  rproxy --> prefsctrl
  rproxy --> uploadctrl
  spadoc --> routetable
  shellctrl --> viewservices
  pagectrls --> viewservices
  viewservices --> fixtureclasses
  viewservices --> format
  collectctrl --> ingestsvc
  ingestsvc --> trackedevent
  ingestsvc --> eventtopic
  ingestsvc --> dedup
  ingestsvc --> mercurepub
  loginctrl --> loginsvc
  prefsctrl --> prefssvc
  uploadctrl --> uploadsvc
  uploadsvc --> importstore
  loginsvc --> session
  prefssvc --> session
  session --> springsession
  scheduling --> shedlock
  dedup --> eventdedup
  mercurepub -.->|"plain HTTP, publisher JWT"| hub
