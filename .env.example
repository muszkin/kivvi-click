# Copy to .env for the DEV stack (compose.yaml); production uses .env.prod.docker.
# .env.prod.docker instead (--env-file). Never put real secrets here.
HTTP_PORT=8080
HTTPS_PORT=8443
MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=!ChangeMe!
