<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>click.kivvi</groupId>
	<artifactId>kivvi-click</artifactId>
	<version>0.1.0</version>
	<name>kivvi-click</name>
	<description>Spring Boot API behind the kivvi-click Vue 3 SPA (wave-0 walking skeleton: login and the panel shell).</description>

	<properties>
		<java.version>25</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<archunit.version>1.5.0</archunit.version>
		<spotless-maven-plugin.version>3.10.2</spotless-maven-plugin.version>
		<google-java-format.version>1.36.1</google-java-format.version>
		<greenmail.version>2.1.3</greenmail.version>
	</properties>

	<dependencies>
		<!-- Web: Spring MVC on Tomcat, Jackson 3 for JSON. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Actuator: /actuator/health, kept off the Mercure edge (see backend/README.md). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!--
		    Repair-1 (F1): plain spring-session-jdbc + spring-boot-starter-jdbc puts
		    JdbcIndexedSessionRepository on the classpath but never registers it — Boot 4
		    splits Flyway-style autoconfiguration (JdbcSessionAutoConfiguration, the bean
		    that actually wires the JDBC-backed SessionRepositoryFilter) into its own
		    spring-boot-session-jdbc module, bundled by this starter. Without it,
		    request.getSession(...) silently falls back to Tomcat's in-memory session:
		    functionally indistinguishable in a single request/response cycle, zero rows
		    ever written to spring_session, identity lost on every container restart —
		    exactly what evidence/repair-1-session-proof-BEFORE.txt shows. wave-0 has no
		    JPA entities, so this (not spring-boot-starter-data-jpa) is the only
		    JDBC-flavoured starter this module needs.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-session-jdbc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
		    Boot 4 splits Flyway's autoconfiguration out of the plain flyway-core
		    dependency into its own module (spring-boot-flyway); without this starter
		    Flyway is on the classpath but FlywayAutoConfiguration never runs, so
		    migrations never execute.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
		    Wave-1 scheduler-heartbeat journey (contract.md): a Postgres-backed distributed
		    lock over the `shedlock` table (frozen in V1__baseline.sql), replacing Symfony
		    Scheduler's stateful()-on-cache.app state (src/Schedule.php) so a restart of the
		    single `api` process (DEV-6: no separate worker container) resumes correctly
		    instead of double-firing. shedlock-spring supplies @EnableSchedulerLock/
		    @SchedulerLock; shedlock-provider-jdbc-template supplies the JdbcTemplateLockProvider
		    that reads/writes that table. Apache-2.0, pinned per the slice packet.
		-->
		<dependency>
			<groupId>net.javacrumbs.shedlock</groupId>
			<artifactId>shedlock-spring</artifactId>
			<version>7.10.0</version>
		</dependency>
		<dependency>
			<groupId>net.javacrumbs.shedlock</groupId>
			<artifactId>shedlock-provider-jdbc-template</artifactId>
			<version>7.10.0</version>
		</dependency>

		<!--
		    PIO-71 (double opt-in). Two starters, both taking their version from the Boot
		    4.1.1 BOM in the parent above - nothing pinned here.

		    Mail: the transport is plain SMTP through spring.mail.*, configured entirely from
		    environment variables, deliberately not a provider SDK. Brevo is today's relay
		    (context/research/2026-09-15-transactional-email-provider.md); moving to another
		    one is four environment variables, not a code change.

		    Thymeleaf: the confirmation mail needs real HTML with every style inlined, which
		    is a template engine's job and not a job for string concatenation. This is the
		    first template engine in this backend; every controller here returns @ResponseBody,
		    so the MVC view resolver it also registers is never reached.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<!-- Test -->
		<!--
		    Boot 4's modular test support splits WebMvcTest and TestRestTemplate out of the
		    plain starter-test into their own artifacts; spring-boot-starter-webmvc-test
		    bundles exactly those two (plus starter-test) without dragging in spring-security
		    test support, which this app has no dependency on.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		    TestRestTemplateTestAutoConfiguration (pulled in by @AutoConfigureTestRestTemplate,
		    used by SessionRoundTripIT) reflects over RestTemplateBuilder at bean-definition
		    time even when the bean method is never selected, so the plain class must be on the
		    classpath — spring-boot-starter-webmvc-test does not pull it in on its own.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-restclient</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
		<!--
		    An SMTP server inside the JVM, so proving that a message really leaves over SMTP
		    costs no Docker container and adds no service to compose.yaml - Postgres stays the
		    only backing service (CLAUDE.md, "Architecture decisions"). Pinned: greenmail
		    publishes no Boot-managed version.
		-->
		<dependency>
			<groupId>com.icegreen</groupId>
			<artifactId>greenmail-junit5</artifactId>
			<version>${greenmail.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- Testcontainers-backed *IT tests run only on `verify` (integration gate), never on
			     plain `test` (focused gate) — standard Surefire/Failsafe naming split. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
			</plugin>

			<!-- Compile-time boundary: every warning is an error, matching the source
			     stack's PHPStan level-5 static-typing gate (architecture/rules-translated.md). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<compilerArgs>
						<arg>-Xlint:all</arg>
						<arg>-Werror</arg>
					</compilerArgs>
				</configuration>
			</plugin>

			<!-- Repair-3 (R3-C): bound to `verify` so `./mvnw verify` — the CI/gate-chain
			     command — actually fails on a formatting violation; previously this plugin had
			     no <executions> at all, so `spotless:check` only ever ran when invoked directly
			     by name, contradicting the CI workflow's own comment. `spotless:apply` (no
			     binding needed — a one-off developer command) still fixes violations. -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>${spotless-maven-plugin.version}</version>
				<configuration>
					<java>
						<googleJavaFormat>
							<version>${google-java-format.version}</version>
						</googleJavaFormat>
						<removeUnusedImports/>
						<importOrder/>
					</java>
				</configuration>
				<executions>
					<execution>
						<id>check-formatting</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
