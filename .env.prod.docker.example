# Template for .env.prod.docker, the production runtime configuration.
# Copy it, fill in the secrets, and keep the real file out of git.
# See README.md's Production operations.
# docker compose -p kivvi-click --env-file .env.prod.docker -f compose.yaml -f compose.prod.yaml up -d --wait

# TLS terminates at the upstream proxy; Mercure's Caddy listens on HTTP for any Host.
SERVER_NAME=:80
HTTP_PORT=23456

# Shared database credentials for PostgreSQL and the Spring Boot API.
POSTGRES_DB=app
POSTGRES_USER=app
# openssl rand -base64 32
POSTGRES_PASSWORD=

# Shared JWT secret for the API publisher/subscriber and Mercure hub.
# openssl rand -base64 48
MERCURE_JWT_SECRET=

# Optional registry/namespace prefix for the built kivvi-click-api image.
IMAGES_PREFIX=
