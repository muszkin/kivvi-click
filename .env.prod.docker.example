# Template for .env.prod.docker — the runtime configuration of the production stack. Shared,
# single copy: both the old stack and the next stack (Spring Boot + Vue) read this same file —
# see README.md's "Next stack (Spring Boot + Vue)" section for the full command sequence.
# Copy it, fill in the secrets, and keep the real file out of git (it already is).
#
#   old stack:  docker compose --env-file .env.prod.docker -f compose.yaml -f compose.prod.yaml up -d --wait
#   next stack: docker compose --env-file .env.prod.docker -f compose.next.yaml -f compose.next.prod.yaml up -d --wait
#
# TLS is terminated by the reverse proxy in front of the app (https://kivvi.click); both
# stacks' edge (Caddy — either FrankenPHP's embedded Caddy or the standalone `mercure`
# container) serves plain HTTP on the published port and reads X-Forwarded-* from it.

APP_ENV=prod
# openssl rand -hex 32
APP_SECRET=

# Caddy listens on :80 for any Host — the proxy decides which name reaches us. Read by both
# stacks' edge service (php / mercure).
SERVER_NAME=:80
# Read by both stacks (never both up at once — see README.md's cutover sequence).
HTTP_PORT=23456
# Old stack only: published but inert, nothing listens on 443 inside the container (no TLS
# here). The next stack's compose.next.prod.yaml drops these two published ports entirely
# (mercure `ports: !override`), so they are meaningless once the next stack is running.
HTTPS_PORT=23457
HTTP3_PORT=23457

# Public address, used for absolute URLs generated outside a request (scheduler, worker).
# Old stack only — the next stack builds no absolute URLs outside a request.
DEFAULT_URI=https://kivvi.click
CADDY_MERCURE_PUBLIC_URL=https://kivvi.click/.well-known/mercure
# openssl rand -base64 48
CADDY_MERCURE_JWT_SECRET=

# Read by both stacks' database service (POSTGRES_DB/POSTGRES_USER) and, for the next stack,
# also by `api` (SPRING_DATASOURCE_PASSWORD in compose.next.prod.yaml derives from
# POSTGRES_PASSWORD directly — one documented secret, not a second independently-named one).
POSTGRES_VERSION=18
POSTGRES_DB=app
POSTGRES_USER=app
# openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Next stack (Spring Boot + Vue) only ---

# The Mercure hub JWT, read by both the `api` container (MERCURE_PUBLISHER_JWT_KEY /
# MERCURE_SUBSCRIBER_JWT_KEY / MERCURE_JWT_SECRET — all three derive from this one value, see
# compose.next.prod.yaml) and the `mercure` container itself. Distinct from the old stack's
# CADDY_MERCURE_JWT_SECRET above — different services, different key — set both when both
# stacks share this host during the RR-1/CUT-1 window.
# openssl rand -base64 48
MERCURE_JWT_SECRET=

# Optional registry/namespace prefix for the built image name (kivvi-click-api). Leave unset
# for a plain local tag; compose.next.prod.yaml already defaults it to empty.
IMAGES_PREFIX=
