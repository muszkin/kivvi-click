# Template for .env.prod.docker, the production runtime configuration.
# Copy it, fill in the secrets, and keep the real file out of git.
# See README.md's Production operations.
# docker compose -p kivvi-click --env-file .env.prod.docker -f compose.yaml -f compose.prod.yaml up -d --wait

# TLS terminates at the upstream proxy; Mercure's Caddy listens on HTTP for any Host.
SERVER_NAME=:80
HTTP_PORT=23456

# Shared database credentials for PostgreSQL and the Spring Boot API.
POSTGRES_DB=app
POSTGRES_USER=app
# openssl rand -base64 32
POSTGRES_PASSWORD=

# Shared JWT secret for the API publisher/subscriber and Mercure hub.
# openssl rand -base64 48
MERCURE_JWT_SECRET=

# Transactional mail (PIO-71). Brevo's SMTP relay — all EU processing, DPA without standard
# contractual clauses (context/research/2026-09-15-transactional-email-provider.md). The password
# is the SMTP key from Brevo's SMTP & API -> SMTP screen: NOT the account password and NOT an
# API v3 key. Outside the `dev` profile the application refuses to start without a host, and
# without a username and password whenever the relay wants authentication.
#
# Before the first send, the domain needs SPF and DKIM as Brevo specifies them, and DMARC at
# p=none — otherwise confirmations land in spam and a cold domain burns its reputation.
# The names match compose.portainer.yaml's, which is what production actually deploys.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Absolute base for the links inside those messages, and the address they come from.
# piotr@kivvi.click is the verified sender on the authenticated domain; sending as anything else
# on kivvi.click breaks DKIM alignment.
KIVVI_BASE_URL=https://kivvi.click
MAIL_FROM=piotr@kivvi.click

# Derives every unsubscribe link from the subscriber's id, so a link in a message from a year ago
# still works without the token ever being stored in the clear. Rotating this breaks every
# unsubscribe link already in the wild.
# openssl rand -base64 48
KIVVI_UNSUBSCRIBE_SECRET=

# Optional registry/namespace prefix for the built kivvi-click-api image.
IMAGES_PREFIX=
