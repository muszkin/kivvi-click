# Template for .env.prod.docker — the runtime configuration of the production stack.
# Copy it, fill in the secrets, and keep the real file out of git (it already is).
#
#   docker compose --env-file .env.prod.docker -f compose.yaml -f compose.prod.yaml up -d --wait
#
# TLS is terminated by the reverse proxy in front of the app (https://kivvi.click);
# Caddy here serves plain HTTP on the published port and reads X-Forwarded-* from it.

APP_ENV=prod
# openssl rand -hex 32
APP_SECRET=

# Caddy listens on :80 for any Host — the proxy decides which name reaches us.
SERVER_NAME=:80
HTTP_PORT=23456
# Published but inert: nothing listens on 443 inside the container (no TLS here).
HTTPS_PORT=23457
HTTP3_PORT=23457

# Public address, used for absolute URLs generated outside a request (scheduler, worker).
DEFAULT_URI=https://kivvi.click
CADDY_MERCURE_PUBLIC_URL=https://kivvi.click/.well-known/mercure
# openssl rand -base64 48
CADDY_MERCURE_JWT_SECRET=

POSTGRES_VERSION=18
POSTGRES_DB=app
POSTGRES_USER=app
# openssl rand -base64 32
POSTGRES_PASSWORD=
