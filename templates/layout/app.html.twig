{#
  LAYOUT · app
  Authenticated shell: sidebar grid column + main scroll region. The scroll container is
  .main-scroll, NOT the window — sticky topbars depend on it.

  Params:
    content (block, required)
    crumb (string) — defaults to the navigation label of the current route

  Usage:
    {% extends 'layout/app.html.twig' %}{% block content %}…{% endblock %}
#}
{% extends 'layout/base.html.twig' %}

{% block body %}
<div class="app" data-sidebar="{{ panel.sidebarState }}" data-controller="shell">
  {{ include('components/organisms/sidebar.html.twig', {
    groups: panel.navGroups,
    current: panel.currentSection,
    workspace: panel.workspace,
    user: panel.user
  }) }}

  <main class="main">
    {{ include('components/organisms/topbar.html.twig', {
      siteName: panel.workspace.name,
      crumb: crumb|default(panel.crumb),
      locale: app.request.locale,
      theme: panel.theme
    }) }}
    <div class="main-scroll scrollable">
      {% block content %}{% endblock %}
    </div>
  </main>
</div>
{% endblock %}
