{#
  STORYBOOK · shell
  Chrome for the storybook itself: group nav, theme + accent controls.
  Deliberately styled with its own sb-* classes so it can never be confused
  with the product design system it displays.
#}
<!doctype html>
<html lang="pl" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Storybook · Kivvi-click</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap">
  <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
  <link rel="stylesheet" href="{{ asset('styles/storybook.css') }}">
</head>
<body class="sb-body">
  <aside class="sb-nav">
    <a class="sb-brand" href="{{ path('storybook_index') }}">
      {{ include('components/atoms/wordmark.html.twig', { size: 20, fontSize: 18 }) }}
    </a>
    <div class="sb-nav-scroll">
      {% for group, ids in groups %}
        <div class="sb-nav-group">{{ group }}</div>
        {% for id in ids %}
          <a class="sb-nav-item" href="{{ path('storybook_story', { id: id }) }}"
             aria-current="{{ id == (id|default('')) and app.request.attributes.get('id') == id ? 'page' : 'false' }}">{{ id }}</a>
        {% endfor %}
      {% endfor %}
    </div>
    <div class="sb-nav-foot">
      <div class="sb-control">
        <span class="sb-control__label">Motyw</span>
        <div class="seg">
          <button data-sb-theme="light" data-active="true">Light</button>
          <button data-sb-theme="dark">Dark</button>
        </div>
      </div>
      <div class="sb-control">
        <span class="sb-control__label">Akcent</span>
        <div class="sb-accents">
          <button data-sb-accent="green" data-active="true" title="Mech"></button>
          <button data-sb-accent="brown" title="Brąz"></button>
          <button data-sb-accent="rust" title="Terakota"></button>
          <button data-sb-accent="plum" title="Śliwka"></button>
        </div>
      </div>
    </div>
  </aside>

  <main class="sb-main">
    {% block storybook_content %}{% endblock %}
  </main>

  <script src="{{ asset('js/storybook-controls.js') }}"></script>
  {{ importmap('app') }}
</body>
</html>
