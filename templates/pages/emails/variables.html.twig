{#
  PARTIAL · email editor / variables
  Copy-to-clipboard list of placeholders, then a word on which A/B variant is shown.

  Params:
    variables (array of {token, description}, required)
#}
<div class="section-title" style="margin-top:22px;">{{ 'Zmienne'|trans }}</div>
<div class="col" style="gap:6px;">
  {%- for v in variables %}
  <div class="row" style="background: var(--bg); border: 1px solid var(--line); padding: 6px 8px; border-radius: 6px; font-family: var(--font-mono); font-size: 11.5px; justify-content: space-between; gap: 8px;">
    <span title="{{ v.description }}">{{ v.token }}</span>
    {{ include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'copy', action: 'copy-variable', payload: v.token }) }}
  </div>
  {%- endfor %}
</div>

<div class="section-title" style="margin-top:22px;">{{ 'Sekcje testów A/B'|trans }}</div>
<div class="muted" style="font-size:12px;">{{ 'Wariant A jest pokazywany. Wariant B otrzymuje 50% ruchu i ma inny temat.'|trans }}</div>
