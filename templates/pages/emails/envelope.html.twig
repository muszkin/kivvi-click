{#
  PARTIAL · email editor / envelope
  Compact sender + subject strip above the 600px document.

  Params:
    template (hash with sender and subject, required)
#}
<div class="row" style="max-width: 600px; margin: 0 auto 14px; background: var(--bg-card); border: 1px solid var(--line); border-radius: var(--radius-md); padding: 10px 14px; gap: 14px;">
  <div style="font-size: 11.5px; color: var(--fg-muted); display:flex; gap: 22px; flex:1; min-width:0;">
    <div><span class="muted">{{ 'Od:'|trans }}</span> <span class="mono">{{ template.sender }}</span></div>
    <div style="min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
      <span class="muted">{{ 'Temat:'|trans }}</span> <span class="mono">{{ template.subject }}</span>
    </div>
  </div>
  {{ include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'edit', action: 'edit-envelope' }) }}
</div>
