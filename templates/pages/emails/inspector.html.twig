{#
  PARTIAL · email editor / inspector
  Properties of the selected block: copy, section background, alignment, padding and
  the condition that decides whether the block is rendered at all.

  Params:
    block (hash from CampaignCatalog::selectedBlock, required)
#}
<div class="muted" style="font-size:11.5px; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px;">{{ 'Wybrany blok'|trans }}</div>
<div class="card" style="padding: 10px; border-radius: 8px; margin-bottom: 16px;">
  <div style="font-weight: 500; font-size: 13px;">{{ block.blockName }}</div>
  <div class="muted mono" style="font-size: 11.5px;">block_id: {{ block.blockId }}</div>
</div>

{{ include('components/atoms/field.html.twig', { name: 'hero_title', label: 'Tytuł'|trans, value: block.title }) }}

{% set placeholderOptions = [] %}
{% for placeholder in block.placeholders %}
  {% set placeholderOptions = placeholderOptions|merge([{ value: placeholder, label: placeholder, selected: loop.first }]) %}
{% endfor %}
{{ include('components/atoms/field.html.twig', { name: 'hero_placeholder', type: 'select', label: 'Wsparcie placeholder'|trans, options: placeholderOptions }) }}

<label class="label">{{ 'Kolor tła sekcji'|trans }}</label>
<div class="row" style="gap: 6px; margin-bottom: 12px;">
  {%- for background in block.backgrounds %}
  <button data-action="set-section-background" data-payload="{{ loop.index0 }}" aria-label="{{ 'Tło'|trans }} {{ loop.index }}"
          aria-pressed="{{ loop.first ? 'true' : 'false' }}"
          style="width:28px; height:28px; border-radius:6px; background:{{ background }}; border:2px solid {{ loop.first ? 'var(--fg)' : 'var(--line)' }}; cursor:pointer;"></button>
  {%- endfor %}
</div>

<label class="label">{{ 'Wyrównanie'|trans }}</label>
{{ include('components/molecules/segmented.html.twig', { action: 'set-section-align', options: [
  { value: 'left', label: 'Lewo'|trans, active: block.alignment == 'left' },
  { value: 'center', label: 'Środek'|trans, active: block.alignment == 'center' },
  { value: 'right', label: 'Prawo'|trans, active: block.alignment == 'right' }] }) }}

<div style="margin-top:12px;">
  {{ include('components/atoms/field.html.twig', { name: 'section_padding', label: 'Padding sekcji'|trans, value: block.padding, mono: true }) }}
</div>

<div class="section-title" style="margin-top: 8px;">{{ 'Warunki widoczności'|trans }}</div>
<div class="muted" style="font-size: 12px; margin-bottom: 8px;">{{ 'Pokaż blok tylko, gdy:'|trans }}</div>
<div class="row" style="gap:4px;">
  {{ include('components/atoms/chip.html.twig', { label: block.visibility, mono: true }) }}
</div>
<div style="margin-top: 8px;">
  {{ include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'plus', label: 'Dodaj warunek'|trans, action: 'add-visibility-rule' }) }}
</div>
