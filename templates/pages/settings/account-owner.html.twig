{#
  PARTIAL · settings / account owner
  Owner identity plus the two session-hardening switches.
#}
<div class="row" style="gap: 14px;">
  {{ include('components/atoms/avatar.html.twig', { name: panel.user.name, size: 48 }) }}
  <div style="flex:1;">
    <div style="font-weight:500;">{{ panel.user.name }}</div>
    <div class="muted mono" style="font-size:12px;">{{ panel.user.email }}</div>
  </div>
  {{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'edit', label: 'Przenieś własność'|trans, action: 'transfer-ownership' }) }}
</div>
<div style="margin-top:18px; padding-top:16px; border-top:1px solid var(--line);">
  {{ include('components/atoms/toggle-row.html.twig', { name: 'require_mfa', checked: true, label: 'Wymagaj 2FA dla wszystkich członków zespołu'|trans }) }}
  {{ include('components/atoms/toggle-row.html.twig', { name: 'session_expiry', checked: true, label: 'Wyloguj sesje po 14 dniach nieaktywności'|trans }) }}
</div>
