{#
  PARTIAL · settings / connected notification channels
#}
<div class="col" style="gap:12px;">
  <div class="row" style="gap:14px; padding:12px 14px; background:var(--bg); border:1px solid var(--line); border-radius:var(--radius-md);">
    <span style="width:32px;height:32px;border-radius:8px;background:var(--accent-soft);color:var(--accent-soft-fg);display:grid;place-items:center;">
      {{ include('components/atoms/icon.html.twig', { name: 'mail' }) }}
    </span>
    <div style="flex:1;">
      <div style="font-weight:500; font-size:13.5px;">E-mail</div>
      <div class="muted mono" style="font-size:12px;">{{ panel.user.email }}</div>
    </div>
    {{ include('components/atoms/chip.html.twig', { label: 'aktywny'|trans, tone: 'good', icon: 'check' }) }}
  </div>
  <div class="row" style="gap:14px; padding:12px 14px; background:var(--bg); border:1px solid var(--line); border-radius:var(--radius-md);">
    <span style="width:32px;height:32px;border-radius:8px;background:var(--brown-soft);color:var(--brown-soft-fg);display:grid;place-items:center;">
      {{ include('components/atoms/icon.html.twig', { name: 'bell' }) }}
    </span>
    <div style="flex:1;">
      <div style="font-weight:500; font-size:13.5px;">Slack</div>
      <div class="muted mono" style="font-size:12px;">#kivvi-alerty · workspace aurea</div>
    </div>
    {{ include('components/atoms/button.html.twig', { size: 'sm', label: 'Rozłącz'|trans, action: 'disconnect-slack' }) }}
  </div>
  <div class="row" style="gap:14px; padding:12px 14px; background:var(--bg); border:1px solid var(--line); border-radius:var(--radius-md);">
    <span style="width:32px;height:32px;border-radius:8px;background:var(--bg-sunken);color:var(--fg-muted);display:grid;place-items:center;">
      {{ include('components/atoms/icon.html.twig', { name: 'user' }) }}
    </span>
    <div style="flex:1;">
      <div style="font-weight:500; font-size:13.5px;">SMS</div>
      <div class="muted" style="font-size:12px;">{{ 'Tylko krytyczne alerty · dodatkowo płatne'|trans }}</div>
    </div>
    {{ include('components/atoms/button.html.twig', { variant: 'primary', size: 'sm', label: 'Podłącz'|trans, action: 'connect-sms' }) }}
  </div>
</div>
