{#
  PARTIAL · settings / Plan i płatności
  Current plan, limit usage, payment method and invoices.
#}
{{ include('components/molecules/card.html.twig', {
  class: 'plan-card',
  body: include('pages/settings/plan-summary.html.twig')
}) }}

{{ include('components/molecules/card.html.twig', {
  title: 'Wykorzystanie limitów'|trans, sub: 'okres 1–26 sierpnia 2026'|trans,
  body: include('pages/settings/limit-bars.html.twig', { bars: settings.planUsage })
}) }}

{{ include('components/molecules/card.html.twig', {
  title: 'Metoda płatności'|trans,
  headActions: include('components/atoms/button.html.twig', { size: 'sm', icon: 'edit', label: 'Zmień'|trans, action: 'change-payment-method' }),
  body: include('pages/settings/payment-method.html.twig')
}) }}

{% set tableColumns = [
  { label: 'Numer'|trans }, { label: 'Data'|trans }, { label: 'Kwota netto'|trans, align: 'right' },
  { label: 'Status'|trans }, { label: '', align: 'right' }
] %}
{% set rows = [] %}
{% for invoice in settings.invoices %}
  {% set rows = rows|merge([[
    '<span class="mono" style="font-size:12.5px;">' ~ invoice.number ~ '</span>',
    '<span class="muted" style="font-size:12.5px;">' ~ invoice.date ~ '</span>',
    '<span class="mono">' ~ invoice.amount ~ '</span>',
    include('components/atoms/chip.html.twig', { label: invoice.status, tone: 'good' }),
    include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'download', action: 'download-invoice', payload: invoice.number })
  ]]) %}
{% endfor %}

{{ include('components/molecules/card.html.twig', {
  title: 'Faktury'|trans,
  headActions: include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'download', label: 'Pobierz wszystkie'|trans, action: 'download-invoices' }),
  raw: include('components/molecules/table.html.twig', { columns: tableColumns, rows: rows })
}) }}
