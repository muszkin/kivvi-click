{#
  PARTIAL · settings / Śledzone strony
  Tracked domains, the tracker snippet with its detection state, and the automatic events.
#}
{% set tableColumns = [
  { label: 'Domena'|trans }, { label: 'Status śledzenia'|trans },
  { label: 'Zdarzeń (24h)'|trans, align: 'right' }, { label: 'Skrypt'|trans, align: 'right' }, { label: '' }
] %}
{% set rows = [] %}
{% for site in settings.trackedSites %}
  {% set rows = rows|merge([[
    '<div class="row">' ~ include('components/atoms/dot.html.twig', { color: site.color }) ~ '<span style="font-weight:500;">' ~ site.name ~ '</span></div>',
    include('components/atoms/chip.html.twig', { label: 'Aktywne'|trans, tone: 'good', live: true }),
    '<span class="mono">' ~ site.events ~ '</span>',
    '<span class="mono" style="font-size:11px; color: var(--fg-muted);">' ~ site.key ~ '</span>',
    include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'settings', action: 'edit-site', payload: site.name })
  ]]) %}
{% endfor %}

{{ include('components/molecules/card.html.twig', {
  title: 'Śledzone strony'|trans, sub: '3 z 5 wykorzystane w planie Pro'|trans,
  headActions: include('components/atoms/button.html.twig', { variant: 'primary', size: 'sm', icon: 'plus', label: 'Dodaj stronę'|trans, action: 'add-site' }),
  raw: include('components/molecules/table.html.twig', { columns: tableColumns, rows: rows })
}) }}

{{ include('components/molecules/card.html.twig', {
  title: 'Instalacja skryptu'|trans, icon: 'code', sub: 'aureashop.pl',
  headActions: include('components/atoms/button.html.twig', { size: 'sm', icon: 'copy', label: 'Kopiuj snippet'|trans, action: 'copy-snippet' }),
  body: include('pages/settings/tracker-snippet.html.twig', { snippet: tracker_snippet })
}) }}

{{ include('components/molecules/card.html.twig', {
  title: 'Zdarzenia automatyczne'|trans, icon: 'bolt', sub: 'wykrywane bez konfiguracji'|trans,
  body: include('pages/settings/automatic-events.html.twig', { events: settings.automaticEvents })
}) }}
