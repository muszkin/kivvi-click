{#
  PARTIAL · settings / export and erasure
#}
<div class="col" style="gap:12px;">
  <div class="row" style="gap:14px;">
    <div style="flex:1;">
      <div style="font-weight:500; font-size:13.5px;">{{ 'Eksport wszystkich danych konta'|trans }}</div>
      <div class="muted" style="font-size:12.5px;">{{ 'JSON + CSV, przygotowanie do 24 godzin'|trans }}</div>
    </div>
    {{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'download', label: 'Zamów eksport'|trans, action: 'export' }) }}
  </div>
  <div class="row" style="gap:14px; padding-top:12px; border-top:1px solid var(--line);">
    <div style="flex:1;">
      <div style="font-weight:500; font-size:13.5px;">{{ 'Usuń dane pojedynczego klienta'|trans }}</div>
      <div class="muted" style="font-size:12.5px;">{{ 'Po e-mailu lub customer_id — natychmiastowe i nieodwracalne'|trans }}</div>
    </div>
    {{ include('components/atoms/button.html.twig', { variant: 'danger', size: 'sm', icon: 'trash', label: 'Usuń klienta'|trans, action: 'erase-customer' }) }}
  </div>
</div>
