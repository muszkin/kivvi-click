{#
  PARTIAL · settings / automatically collected events

  Params:
    events (array of string, required)
#}
<div class="auto-events">
  {%- for event in events %}
  <div class="row" style="gap: 8px; padding: 10px 12px; background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius-sm); font-size: 12.5px;">
    {{ include('components/atoms/chip.html.twig', { label: 'ON', tone: 'good' }) }}
    <span class="mono">{{ event }}</span>
  </div>
  {%- endfor %}
</div>
