{#
  PARTIAL · settings / roles

  Params:
    roles (array of {name, description, count}, required)
#}
<div class="col" style="gap:10px;">
  {%- for role in roles %}
  <div class="row" style="gap:14px; padding:12px 14px; background: var(--bg); border:1px solid var(--line); border-radius: var(--radius-md);">
    <div style="flex:1; min-width:0;">
      <div style="font-weight:500; font-size:13.5px;">{{ role.name }}</div>
      <div class="muted" style="font-size:12.5px;">{{ role.description }}</div>
    </div>
    {{ include('components/atoms/chip.html.twig', { label: role.count ~ ' ' ~ (role.count == 1 ? 'osoba'|trans : 'osoby'|trans) }) }}
    {{ include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'chevron_r', action: 'open-role', payload: role.name }) }}
  </div>
  {%- endfor %}
</div>
