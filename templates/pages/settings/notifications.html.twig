{#
  PARTIAL · settings / Powiadomienia
  Event × channel matrix, the connected channels, and quiet hours.
#}
{% set tableColumns = [
  { label: 'Zdarzenie'|trans }, { label: 'E-mail' }, { label: 'Slack' }, { label: 'SMS' }
] %}
{% set rows = [] %}
{% for row in settings.notificationMatrix %}
  {% set rows = rows|merge([[
    '<span style="font-weight:500;">' ~ row.label ~ '</span>',
    include('pages/settings/notification-toggle.html.twig', { channel: 'email', label: row.label, checked: row.email }),
    include('pages/settings/notification-toggle.html.twig', { channel: 'slack', label: row.label, checked: row.slack }),
    include('pages/settings/notification-toggle.html.twig', { channel: 'sms', label: row.label, checked: row.sms })
  ]]) %}
{% endfor %}

{{ include('components/molecules/card.html.twig', {
  title: 'Kanały powiadomień'|trans, icon: 'bell', sub: 'ustawienia dotyczą Twojego konta, nie całego zespołu'|trans,
  raw: include('components/molecules/table.html.twig', { columns: tableColumns, rows: rows, scroll: true })
}) }}

{{ include('components/molecules/card.html.twig', {
  title: 'Integracje kanałów'|trans,
  body: include('pages/settings/notification-channels.html.twig')
}) }}

{{ include('components/molecules/card.html.twig', {
  title: 'Cisza nocna'|trans,
  body: include('pages/settings/quiet-hours.html.twig')
}) }}
