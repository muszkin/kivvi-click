{#
  PARTIAL · settings / e-mail providers

  Params:
    providers (array, required)
#}
<div class="col" style="gap:12px;">
  {%- for p in providers %}
  <div class="provider-row">
    <div style="min-width:0; flex:1;">
      <div class="row" style="gap:8px; flex-wrap: wrap;">
        <strong style="font-size:14px;">{{ p.name }}</strong>
        {{ include('components/atoms/chip.html.twig', { label: p.statusLabel, tone: p.statusTone }) }}
        {%- if p.verified %}
          {{ include('components/atoms/chip.html.twig', { label: 'zweryfikowany'|trans, tone: 'good', icon: 'check' }) }}
        {%- else %}
          {{ include('components/atoms/chip.html.twig', { label: 'niezweryfikowany'|trans, tone: 'warn' }) }}
        {%- endif %}
      </div>
      <div class="muted mono" style="font-size:11.5px; margin-top:3px;">region: {{ p.region }}</div>
    </div>
    <div class="provider-metrics">
      <div>
        <div class="muted" style="font-size:10.5px; text-transform:uppercase; letter-spacing:0.06em;">{{ 'Wysłane 30d'|trans }}</div>
        <div class="mono" style="font-weight:500;">{{ p.sent }}</div>
      </div>
      <div>
        <div class="muted" style="font-size:10.5px; text-transform:uppercase; letter-spacing:0.06em;">Bounce</div>
        <div class="mono" style="font-weight:500; color: {{ p.bounceWarn ? 'var(--warn)' : 'var(--good)' }};">{{ p.bounce }}</div>
      </div>
      <div>
        <div class="muted" style="font-size:10.5px; text-transform:uppercase; letter-spacing:0.06em;">{{ 'Skargi'|trans }}</div>
        <div class="mono" style="font-weight:500;">{{ p.complaint }}</div>
      </div>
    </div>
    <div class="row" style="gap:4px;">
      {{ include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'settings', action: 'edit-provider', payload: p.name }) }}
      {{ include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'play', label: 'Test'|trans, action: 'test-provider', payload: p.name }) }}
    </div>
  </div>
  {%- endfor %}
</div>
