{#
  PAGE · Strumień zdarzeń
  Route: GET /{_locale}/events
  Purpose: Raw searchable event log with type and site filters.

  Structure:
    page-head (live chip, pause, CSV export, webhook)
    events-toolbar x2 — type filter chips, site filter chips + range segmented
    card > event-stream (30 rows) + card-foot with "load more"
#}
{% extends 'layout/app.html.twig' %}
{% block content %}
<div class="page">
  {{ include('components/organisms/page-head.html.twig', { title: 'events.title'|trans, sub: 'events.sub'|trans, actions: block('actions') }) }}

  <div class="events-toolbar">
    <span class="muted" style="font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.06em;">{{ 'Typ'|trans }}:</span>
    {%- for t in type_filters %}{{ include('components/molecules/filter-chip.html.twig', t) }}{% endfor %}
  </div>
  <div class="events-toolbar" style="margin-bottom: 18px;">
    <span class="muted" style="font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.06em;">{{ 'Strona'|trans }}:</span>
    {%- for s in site_filters %}{{ include('components/molecules/filter-chip.html.twig', s) }}{% endfor %}
    <div style="flex:1;"></div>
    <span class="muted" style="font-size:12px;">{{ 'Okres'|trans }}:</span>
    {{ include('components/molecules/segmented.html.twig', { action: 'set-range', options: ranges }) }}
  </div>

  {{ include('components/molecules/card.html.twig', {
    title: 'Log zdarzeń'|trans, icon: 'list', sub: total ~ ' ' ~ 'zdarzeń w wybranym oknie'|trans,
    headActions: include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'search', label: 'Szukaj w logu'|trans, action: 'search-events' }),
    raw: include('components/organisms/event-stream.html.twig', { events: events, topic: mercure_topic }),
    foot: '<span class="muted" style="font-size:12px;">' ~ 'Pokazuję ostatnie'|trans ~ ' ' ~ shown ~ ' ' ~ 'z'|trans ~ ' ' ~ total ~ '</span><div style="margin-left:auto;">'
        ~ include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', label: 'Załaduj więcej'|trans, action: 'load-more-events' }) ~ '</div>'
  }) }}
</div>
{% endblock %}

{% block actions %}
  {{ include('components/atoms/chip.html.twig', { label: 'common.live'|trans, tone: 'good', live: true }) }}
  {{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'pause', label: 'Pauza'|trans, action: 'pause-stream' }) }}
  {{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'download', label: 'Eksport (CSV)'|trans, action: 'export' }) }}
  {{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'code', label: 'Webhook'|trans, href: path('settings', { tab: 'api' }) }) }}
{% endblock %}
