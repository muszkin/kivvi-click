{#
  PAGE · Ustawienia
  Route: GET /{_locale}/settings/{tab}
  Purpose: Eight-tab account configuration surface.

  Structure:
    page-head — subtitle changes per tab
    settings-grid 220px/1fr — settings-nav | tab partial
    tabs: account, sites, team, providers, api, notifications, billing, gdpr
#}
{% extends 'layout/app.html.twig' %}
{% block content %}
<div class="page">
  {{ include('components/organisms/page-head.html.twig', { title: 'settings.title'|trans, sub: tab_subtitle }) }}

  <div class="settings-grid">
    {{ include('components/organisms/settings-nav.html.twig', { tabs: tabs, current: tab }) }}
    <div class="col" style="gap: 16px;">
      {{ include('pages/settings/' ~ tab ~ '.html.twig') }}
    </div>
  </div>
</div>
{% endblock %}
