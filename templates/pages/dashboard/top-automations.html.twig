{#
  PARTIAL · dashboard / best-performing automations
  Four rows: name + channel chips, runs, conversion, revenue.

  Params:
    automations (array of {id, name, channels, runs, conversion, revenue}, required)
#}
<div>
  {%- for a in automations %}
  <a class="event-row" href="{{ path('automation_edit', { id: a.id }) }}" style="grid-template-columns: 1fr auto auto auto; text-decoration: none; color: inherit;">
    <div>
      <div style="font-weight:500; font-size:13.5px;">{{ a.name }}</div>
      <div class="muted" style="font-size:11.5px; margin-top:2px;">
        {%- for channel in a.channels %}{{ include('components/atoms/chip.html.twig', { label: channel }) }}{% endfor %}
      </div>
    </div>
    <div class="mono right" style="min-width:80px;">
      <div style="font-weight:500;">{{ a.runs }}</div>
      <div class="muted" style="font-size:10.5px;">{{ 'uruchomień'|trans }}</div>
    </div>
    <div class="mono right" style="min-width:80px;">
      <div style="font-weight:500; color: var(--good);">{{ a.conversion }}</div>
      <div class="muted" style="font-size:10.5px;">{{ 'konwersja'|trans }}</div>
    </div>
    <div class="mono right" style="min-width:100px;">
      <div style="font-weight:500;">{{ a.revenue }}</div>
      <div class="muted" style="font-size:10.5px;">{{ 'przychód'|trans }}</div>
    </div>
  </a>
  {%- endfor %}
</div>
