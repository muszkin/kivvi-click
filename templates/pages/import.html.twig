{#
  PAGE · Import klientów
  Route: GET /{_locale}/import/{step}
  Purpose: Four-step configurable CSV/XML customer import.

  Structure:
    page-head (history, docs)
    stepper x4
    step 1 — wiz-layout: dropzone + template/API cards | recent imports (sticky)
    step 2 — file-pill, auto-detect callout, map-row table, validation card
    step 3 — rules-grid: dedup strategy, conditional segments, GDPR consent (span 2)
    step 4 — kpi summary x4, preview table with error rows, final options
    wiz-actions — back / forward, primary CTA counts the rows
#}
{% extends 'layout/app.html.twig' %}
{% block content %}
<div class="page">
  {{ include('components/organisms/page-head.html.twig', { title: 'import.title'|trans, sub: 'import.sub'|trans, actions: block('actions') }) }}

  {{ include('components/molecules/stepper.html.twig', { steps: steps, current: step, action: 'set-import-step' }) }}

  {% if step == 1 %}
    <div class="wiz-layout">
      <div>{{ include('pages/import/step-upload.html.twig') }}</div>
      <div>{{ include('pages/import/recent-imports.html.twig', { imports: recent }) }}</div>
    </div>
  {% elseif step == 2 %}
    {{ include('pages/import/step-mapping.html.twig', { file: file, columns: columns, detection: detection, validations: validations }) }}
  {% elseif step == 3 %}
    {{ include('pages/import/step-rules.html.twig', { strategies: dedup_strategies }) }}
  {% else %}
    {{ include('pages/import/step-run.html.twig', { summary: summary, preview: preview, row_count: row_count, error_count: error_count }) }}
  {% endif %}
</div>
{% endblock %}

{% block actions %}
  {{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'list', label: 'Historia importów'|trans, action: 'import-history' }) }}
  {{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'book', label: 'Jak to działa'|trans, action: 'open-docs' }) }}
{% endblock %}
