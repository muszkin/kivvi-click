{#
  PARTIAL · automation editor / rule test
  Three read-outs from the simulation over historical events.

  Params:
    simulation (array of {label, value, note, color?}, required)
#}
<div style="display:grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px;">
  {%- for item in simulation %}
  <div>
    <div class="muted" style="font-size:11.5px; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.06em;">{{ item.label }}</div>
    <div class="mono" style="font-size: 24px; font-weight: 500; letter-spacing: -0.02em;{% if item.color is defined %} color: {{ item.color }};{% endif %}">{{ item.value|raw }}</div>
    <div class="muted" style="font-size: 11.5px;">{{ item.note }}</div>
  </div>
  {%- endfor %}
</div>
