{#
  PAGE · Logowanie
  Route: GET|POST /{_locale}/login
  Purpose: Enter the panel. Uses the auth split layout.
#}
{% extends 'layout/auth.html.twig' %}

{% block title %}{{ 'auth.welcome_back'|trans }} — kivvi·click{% endblock %}

{% block content %}
  <h1>{{ 'auth.welcome_back'|trans }}</h1>
  <p class="sub">{{ 'auth.login_sub'|trans }}</p>

  <form method="post">
    {{ include('components/atoms/field.html.twig', {
      name: '_username', type: 'email', label: 'Email'|trans,
      value: last_username|default('maciej@aureashop.pl')
    }) }}
    {{ include('components/atoms/field.html.twig', { name: '_password', type: 'password', label: 'Hasło'|trans }) }}

    {% if error_message %}
      {{ include('components/molecules/callout.html.twig', { tone: 'bad', icon: 'info', text: error_message }) }}
    {% endif %}

    {{ include('components/atoms/button.html.twig', {
      variant: 'primary', size: 'lg', label: 'Zaloguj się →'|trans, type: 'submit',
      attrs: { style: 'width: 100%; justify-content: center; margin-top: 8px;' }
    }) }}
  </form>

  <div class="row" style="margin: 18px 0; gap: 10px;">
    <div style="flex:1; height:1px; background: var(--line);"></div>
    <span class="muted" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em;">{{ 'lub'|trans }}</span>
    <div style="flex:1; height:1px; background: var(--line);"></div>
  </div>

  {{ include('components/atoms/button.html.twig', {
    size: 'lg', label: 'Kontynuuj z Google'|trans, action: 'sign-in-with-google',
    attrs: { style: 'width: 100%; justify-content: center;' }
  }) }}

  <p class="muted" style="font-size: 13px; margin-top: 24px; text-align: center;">
    {{ 'auth.no_account'|trans }}
    <a href="{{ path('login') }}" style="color: var(--accent); font-weight: 500;">{{ 'auth.register_cta'|trans }}</a>
  </p>
{% endblock %}
