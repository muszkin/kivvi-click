{#
  PARTIAL · popup editor / inspector
  Content fields, accent, position grid, triggers, audience and the A/B switch.

  Params:
    widget (hash with content, required)
    triggers (array of trigger-row param hashes, required)
    audience (array of {label, checked}, required)
    accent_colors (array of string, required)
#}
<div class="muted" style="font-size:11.5px; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px;">{{ 'Wybrany blok'|trans }}</div>
<div class="card" style="padding: 10px; border-radius: 8px; margin-bottom: 16px;">
  <div style="font-weight: 500; font-size: 13px;">{{ 'Nagłówek + opis'|trans }}</div>
  <div class="muted mono" style="font-size: 11.5px;">block_id: heading_1</div>
</div>

{{ include('components/atoms/field.html.twig', { name: 'widget_title', label: 'Nagłówek'|trans, value: widget.content.title|default('') }) }}
{{ include('components/atoms/field.html.twig', { name: 'widget_body', type: 'textarea', label: 'Opis'|trans, value: widget.content.body|default('') }) }}
{{ include('components/atoms/field.html.twig', { name: 'widget_cta', label: 'Tekst przycisku'|trans, value: widget.content.cta|default('') }) }}

<label class="label">{{ 'Kolor akcentu widgetu'|trans }}</label>
<div class="row" style="gap: 6px; margin-bottom: 12px;">
  {%- for color in accent_colors %}
  <button data-action="set-widget-accent" data-payload="{{ loop.index0 }}" aria-label="{{ 'Kolor'|trans }} {{ loop.index }}"
          aria-pressed="{{ loop.first ? 'true' : 'false' }}"
          style="width:28px; height:28px; border-radius:6px; background:{{ color }}; border:2px solid {{ loop.first ? 'var(--fg)' : 'var(--line)' }}; cursor:pointer;"></button>
  {%- endfor %}
</div>

<label class="label">{{ 'Pozycja'|trans }}</label>
{{ include('components/molecules/position-grid.html.twig', { selected: 4 }) }}

<label class="label" style="margin-top:12px;">{{ 'Zaokrąglenie i cień'|trans }}</label>
{{ include('components/molecules/segmented.html.twig', { action: 'set-widget-radius', options: [
  { value: 'sharp', label: 'Ostre'|trans },
  { value: 'soft', label: 'Miękkie'|trans, active: true },
  { value: 'full', label: 'Pełne'|trans }] }) }}

<div class="section-title" style="margin-top:18px;">{{ include('components/atoms/icon.html.twig', { name: 'bolt' }) }} {{ 'Wyzwalacze'|trans }}</div>
<div class="col" style="gap:8px;">
  {%- for trigger in triggers %}{{ include('components/molecules/trigger-row.html.twig', trigger) }}{% endfor %}
  {{ include('components/molecules/add-slot.html.twig', { label: 'Dodaj wyzwalacz'|trans, action: 'add-trigger' }) }}
</div>

<div class="section-title" style="margin-top:20px;">{{ include('components/atoms/icon.html.twig', { name: 'filter' }) }} {{ 'Kto zobaczy'|trans }}</div>
<div class="col" style="gap:6px;">
  {%- for rule in audience %}
    {{ include('components/atoms/toggle-row.html.twig', { name: 'audience[]', label: rule.label, checked: rule.checked, value: loop.index0 }) }}
  {%- endfor %}
</div>

<div class="section-title" style="margin-top:20px;">{{ include('components/atoms/icon.html.twig', { name: 'target' }) }} {{ 'Test A/B'|trans }}</div>
<div class="muted" style="font-size:12px; margin-bottom:8px;">{{ 'Wariant B dostaje 50% ruchu i inny nagłówek.'|trans }}</div>
{{ include('components/molecules/segmented.html.twig', { action: 'set-variant', options: [
  { value: 'a', label: 'Wariant A'|trans, active: true },
  { value: 'b', label: 'Wariant B'|trans },
  { value: 'new', label: '+ Nowy'|trans }] }) }}
