{#
  PARTIAL · popup editor / block library + variables

  Params:
    blocks (array of {icon, label, type}, required)
    variables (array of string, required)
#}
<div class="section-title" style="margin-top:20px;">{{ 'Bloki'|trans }}</div>
{{ include('components/organisms/block-library.html.twig', { blocks: blocks }) }}

<div class="section-title" style="margin-top:20px;">{{ 'Zmienne'|trans }}</div>
<div class="col" style="gap:6px;">
  {%- for v in variables %}
  <div class="row" style="background: var(--bg); border: 1px solid var(--line); padding: 6px 8px; border-radius: 6px; font-family: var(--font-mono); font-size: 11.5px; justify-content: space-between; gap: 8px;">
    <span>{{ v }}</span>
    {{ include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'copy', action: 'copy-variable', payload: v }) }}
  </div>
  {%- endfor %}
</div>
