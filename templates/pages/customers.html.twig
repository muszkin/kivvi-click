{#
  PAGE · Klienci
  Route: GET /{_locale}/customers
  Purpose: Segment-filtered customer index.

  Structure:
    page-head (CSV export, segments, new segment)
    segment rail — filter-chip row
    card > table (7 columns, row click routes to customer detail)
    pagination
#}
{% extends 'layout/app.html.twig' %}
{% block content %}
<div class="page">
  {{ include('components/organisms/page-head.html.twig', { title: 'customers.title'|trans, sub: subtitle, actions: block('actions') }) }}

  <div class="row" style="margin-bottom:18px; gap:8px; flex-wrap: wrap;">
    {%- for s in segments %}{{ include('components/molecules/filter-chip.html.twig', s) }}{% endfor %}
    <div style="flex:1;"></div>
    {{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'filter', label: 'Filtry'|trans, action: 'open-filters' }) }}
  </div>

  {% set tableColumns = [
    { label: 'Klient'|trans },
    { label: 'Email'|trans },
    { label: 'Segment'|trans },
    { label: 'Zamówienia'|trans, align: 'right' },
    { label: 'Wartość życiowa'|trans, align: 'right' },
    { label: 'Ostatnia aktywność'|trans },
    { label: 'Akcje'|trans, align: 'right' }
  ] %}
  {% set rows = [] %}
  {% set rowActions = [] %}
  {% for c in customers_rows %}
    {% set rows = rows|merge([[
      '<div class="row">' ~ include('components/atoms/avatar.html.twig', { name: c.name, size: 28 }) ~ '<span style="font-weight:500;">' ~ c.name ~ '</span></div>',
      '<span class="mono" style="font-size:12px; color: var(--fg-muted);">' ~ c.email ~ '</span>',
      include('components/atoms/chip.html.twig', c.segment),
      '<span class="mono">' ~ c.orders ~ '</span>',
      '<span class="mono">' ~ c.revenue ~ '</span>',
      '<span class="muted" style="font-size:12px;">' ~ c.lastSeen ~ '</span>',
      include('components/atoms/icon.html.twig', { name: 'chevron_r' })
    ]]) %}
    {% set rowActions = rowActions|merge([{ action: 'navigate', payload: path('customer_show', { id: c.id }) }]) %}
  {% endfor %}

  {{ include('components/molecules/card.html.twig', {
    raw: include('components/molecules/table.html.twig', { columns: tableColumns, rows: rows, rowActions: rowActions })
  }) }}

  {{ include('components/molecules/pagination.html.twig', { page: page, pages: pages }) }}
</div>
{% endblock %}

{% block actions %}
  {{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'download', label: 'Eksport CSV'|trans, action: 'export' }) }}
  {{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'bookmark', label: 'Segmenty'|trans, action: 'open-segments' }) }}
  {{ include('components/atoms/button.html.twig', { variant: 'primary', size: 'sm', icon: 'plus', label: 'Nowy segment'|trans, action: 'new-segment' }) }}
{% endblock %}
