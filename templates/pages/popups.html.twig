{#
  PAGE · Popupy i widgety
  Route: GET /{_locale}/popups
  Purpose: On-site message index with a live preview of the selected widget.

  Structure:
    page-head (templates, new popup)
    split 1fr/360px — list-card column | popup-stage preview + trigger summary card
#}
{% extends 'layout/app.html.twig' %}
{% block content %}
<div class="page">
  {{ include('components/organisms/page-head.html.twig', { title: 'popups.title'|trans, sub: 'popups.sub'|trans, actions: block('actions') }) }}

  <div class="split">
    <div class="col" style="gap: 12px;">
      {%- for p in popups %}
        {{ include('components/organisms/list-card.html.twig', p|merge({
          action: 'navigate',
          payload: path('popups', { preview: p.payload }),
          actions: include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'eye', href: path('popups', { preview: p.payload }) })
                 ~ include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'edit', href: path('popup_edit', { id: p.payload }) })
        })) }}
      {%- endfor %}
    </div>

    <div>
      <div class="section-title">
        {{ include('components/atoms/icon.html.twig', { name: 'eye' }) }} {{ 'Podgląd'|trans }}: {{ selected.name }}
        <span style="margin-left:auto;">{{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'edit', label: 'Edytuj'|trans, href: path('popup_edit', { id: selected.id }) }) }}</span>
      </div>
      {{ include('components/organisms/popup-stage.html.twig', {
        type: selected.type, device: 'desktop',
        widget: include('components/organisms/popup-widget.html.twig', selected.widget)
      }) }}
      <div style="margin-top:14px;">
        {{ include('components/molecules/card.html.twig', { body: include('pages/popups/trigger-summary.html.twig') }) }}
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block actions %}
  {{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'book', label: 'Szablony'|trans, action: 'open-templates' }) }}
  {{ include('components/atoms/button.html.twig', { variant: 'primary', size: 'sm', icon: 'plus', label: 'common.new_popup'|trans, href: path('popup_new') }) }}
{% endblock %}
