{#
  PAGE · Edytor automatyzacji
  Route: GET /{_locale}/automations/{id}
  Purpose: Build the rule. Two interchangeable representations of the same model.

  Structure:
    page-head with view segmented (Lista/Diagram), preview, draft, publish
    tab strip — Budowniczy | Statystyki | Wykonania | Historia
    rule-pipeline OR flow-canvas depending on the `view` variable
    test card — matching events, passing conditions, estimated revenue
#}
{% extends 'layout/app.html.twig' %}
{% block content %}
<div class="page">
  {{ include('components/organisms/page-head.html.twig', {
    title: automation.name, sub: automation.statusLabel,
    back: { label: '← Powrót do listy'|trans, route: path('automations') }, actions: block('actions')
  }) }}

  {{ include('components/molecules/tabs.html.twig', { tabs: tabs }) }}

  {% if view == 'flow' %}
    {{ include('components/organisms/flow-canvas.html.twig', { nodes: nodes, edges: edges }) }}
  {% else %}
    {{ include('components/organisms/rule-pipeline.html.twig', { steps: steps }) }}
  {% endif %}

  <div style="margin-top:20px;">
    {{ include('components/molecules/card.html.twig', {
      title: 'Test reguły'|trans, icon: 'target', sub: 'Uruchom symulację na próbce zdarzeń'|trans,
      headActions: include('components/atoms/button.html.twig', { variant: 'primary', size: 'sm', icon: 'play', label: 'Uruchom test'|trans, action: 'run-test' }),
      body: include('pages/automations/simulation.html.twig', { simulation: simulation })
    }) }}
  </div>
</div>
{% endblock %}

{% block actions %}
  {{ include('components/molecules/segmented.html.twig', { action: 'navigate', options: [
    { value: path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({ view: 'list' })), label: 'Lista'|trans, icon: 'list', active: view == 'list' },
    { value: path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({ view: 'flow' })), label: 'Diagram'|trans, icon: 'flow', active: view == 'flow' }] }) }}
  {{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'eye', label: 'Podgląd'|trans, action: 'preview' }) }}
  {{ include('components/atoms/button.html.twig', { size: 'sm', label: 'common.draft'|trans, action: 'save-draft' }) }}
  {{ include('components/atoms/button.html.twig', { variant: 'primary', size: 'sm', icon: 'play', label: 'common.publish'|trans, action: 'publish', payload: automation.id }) }}
{% endblock %}
