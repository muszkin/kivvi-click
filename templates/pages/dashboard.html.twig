{#
  PAGE · Pulpit
  Route: GET /{_locale}/dashboard
  Purpose: Real-time operational view: is traffic flowing, are automations earning.

  Structure:
    page-head (live chip + export + new automation)
    kpi-grid x4 — events/min, sessions, emails 24h, attributed revenue
    cardiogram — full width, events/second
    dash-grid 1.5fr/1fr — event-stream card | recently-seen card
    list-card table — best-performing automations
#}
{% extends 'layout/app.html.twig' %}
{% block content %}
<div class="page">
  {{ include('components/organisms/page-head.html.twig', {
    title: 'dashboard.title'|trans,
    sub: 'dashboard.sub'|trans,
    actions: block('actions')
  }) }}

  {{ include('components/organisms/kpi-grid.html.twig', { tiles: kpis }) }}

  <div style="margin-bottom: 20px;">
    {{ include('components/organisms/cardiogram.html.twig', {
      id: 'cg-main',
      title: 'dashboard.cardiogram'|trans,
      sub: 'dashboard.cardiogramSub'|trans,
      ranges: [{ label: '5 min', active: true }, { label: '1 godz.' }, { label: '24 godz.' }],
      legend: legend
    }) }}
  </div>

  <div class="dash-grid">
    {{ include('components/molecules/card.html.twig', {
      title: 'dashboard.liveFeed'|trans, sub: 'dashboard.liveFeedSub'|trans, live: true,
      headActions: include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'pause', label: 'Pauza'|trans, action: 'pause-stream' })
                 ~ include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', label: 'Cały log'|trans, href: path('events') }),
      raw: include('components/organisms/event-stream.html.twig', { events: events, topic: mercure_topic })
    }) }}

    {{ include('components/molecules/card.html.twig', {
      title: 'dashboard.recentCustomers'|trans,
      headActions: include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', label: 'Wszyscy'|trans, href: path('customers') }),
      raw: include('pages/dashboard/recent-customers.html.twig', { customers: recent_customers })
    }) }}
  </div>

  <div style="margin-top: 20px;">
    {{ include('components/molecules/card.html.twig', {
      title: 'dashboard.topRules'|trans, sub: 'dashboard.topRulesSub'|trans,
      headActions: include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', label: 'Wszystkie'|trans, href: path('automations') }),
      raw: include('pages/dashboard/top-automations.html.twig', { automations: top_automations })
    }) }}
  </div>
</div>
{% endblock %}

{% block actions %}
  {{ include('components/atoms/chip.html.twig', { label: 'common.live'|trans, tone: 'good', live: true }) }}
  {{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'download', label: 'Eksport'|trans, action: 'export' }) }}
  {{ include('components/atoms/button.html.twig', { variant: 'primary', size: 'sm', icon: 'plus', label: 'common.new_automation'|trans, href: path('automation_new') }) }}
{% endblock %}
