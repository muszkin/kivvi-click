{#
  PAGE · Edytor popupu
  Route: GET /{_locale}/popups/{id}
  Purpose: WYSIWYG widget composer: shape, content, triggers, audience, A/B.

  Structure:
    page-head with device segmented, test on site, draft, publish
    editor-shell: widget-type list + block-library + variables | popup-stage | inspector
#}
{% extends 'layout/app.html.twig' %}
{% block content %}
<div class="page" style="max-width:none; padding: 16px 16px 0;">
  {{ include('components/organisms/page-head.html.twig', {
    title: widget.name, sub: widget.meta,
    back: { label: '← Powrót do listy'|trans, route: path('popups') }, actions: block('actions')
  }) }}

  <div data-controller="editor" data-editor-endpoint="{{ app.request.pathinfo }}">
    {{ include('components/organisms/editor-shell.html.twig', {
      leftTitle: 'Typ widgetu'|trans, leftIcon: 'layout',
      left: include('pages/widgets/type-list.html.twig', { types: types, current: widget.type })
          ~ include('pages/widgets/blocks.html.twig', { blocks: blocks, variables: variables }),
      canvas: include('components/organisms/popup-stage.html.twig', {
        type: widget.type, device: device,
        widget: include('components/organisms/popup-widget.html.twig', widget.content)
      }) ~ include('pages/widgets/stage-meta.html.twig', { type: widget.type, viewport: viewport }),
      right: include('pages/widgets/inspector.html.twig', {
        widget: widget, triggers: triggers, audience: audience, accent_colors: accent_colors
      })
    }) }}
  </div>
</div>
{% endblock %}

{% block actions %}
  {{ include('components/molecules/segmented.html.twig', { action: 'navigate', options: [
    { value: path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({ device: 'desktop' })), label: 'Desktop', icon: 'layout', active: device == 'desktop' },
    { value: path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({ device: 'mobile' })), label: 'Mobile', icon: 'user', active: device == 'mobile' }] }) }}
  {{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'play', label: 'Test na stronie'|trans, action: 'test-on-site' }) }}
  {{ include('components/atoms/button.html.twig', { size: 'sm', label: 'common.draft'|trans, action: 'save-draft' }) }}
  {{ include('components/atoms/button.html.twig', { variant: 'primary', size: 'sm', icon: 'play', label: 'common.publish'|trans, action: 'publish', payload: widget.id }) }}
{% endblock %}
