{#
  PARTIAL · feeds / matching diagnostic
  Left: the join field and its fallback chain. Right: 24h coverage bars.

  Params:
    coverage (array of bar param hashes, required)
    fallback_rules (array of {text, field}, required)
    mismatched (int, required)
#}
<div style="display:grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px;">
  <div>
    <div class="muted" style="font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px;">{{ 'Pole łączące'|trans }}</div>
    <div class="row" style="gap:8px; margin-bottom: 14px;">
      {{ include('components/atoms/chip.html.twig', { label: 'event.product_id', mono: true }) }}
      <span style="color: var(--fg-muted);">⇌</span>
      {{ include('components/atoms/chip.html.twig', { label: 'feed.id', mono: true }) }}
      {{ include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'edit', action: 'edit-join-field' }) }}
    </div>

    <div class="muted" style="font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px;">{{ 'Reguły fallback'|trans }}</div>
    <div class="col" style="gap: 4px;">
      {%- for rule in fallback_rules %}
      <div class="row" style="gap:8px; font-size:12.5px;">
        {{ include('components/atoms/icon.html.twig', { name: 'check' }) }} {{ rule.text }}
        {{ include('components/atoms/chip.html.twig', { label: rule.field, mono: true }) }}
      </div>
      {%- endfor %}
    </div>
  </div>

  <div>
    <div class="muted" style="font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 10px;">{{ 'Stan dopasowania (24h)'|trans }}</div>
    <div class="bars">
      {%- for bar in coverage %}{{ include('components/atoms/bar.html.twig', bar|merge({ labelWidth: 120 })) }}{% endfor %}
    </div>
    {{ include('components/atoms/button.html.twig', {
      variant: 'ghost', size: 'sm', icon: 'list',
      label: 'Pokaż %count% niedopasowanych'|trans({ '%count%': mismatched }),
      action: 'show-mismatched', attrs: { style: 'margin-top: 10px;' }
    }) }}
  </div>
</div>
