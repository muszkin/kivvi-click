{#
  PAGE · Reguły i automatyzacje
  Route: GET /{_locale}/automations
  Purpose: Index of rule-based automations with performance.

  Structure:
    page-head (templates, new automation)
    status filter-chip rail
    list-card per automation — chips for trigger and channels, 3 metrics
#}
{% extends 'layout/app.html.twig' %}
{% block content %}
<div class="page">
  {{ include('components/organisms/page-head.html.twig', { title: 'automations.title'|trans, sub: 'automations.sub'|trans, actions: block('actions') }) }}

  <div class="row" style="margin-bottom: 18px; gap: 8px;">
    {%- for fl in filters %}{{ include('components/molecules/filter-chip.html.twig', fl) }}{% endfor %}
    <div style="flex:1;"></div>
    {{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'filter', label: 'Filtry'|trans, action: 'open-filters' }) }}
  </div>

  <div class="col" style="gap: 12px;">
    {%- for a in automations %}
      {{ include('components/organisms/list-card.html.twig', a|merge({ action: 'navigate', payload: path('automation_edit', { id: a.payload }) })) }}
    {%- endfor %}
  </div>
</div>
{% endblock %}

{% block actions %}
  {{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'book', label: 'Szablony'|trans, action: 'open-templates' }) }}
  {{ include('components/atoms/button.html.twig', { variant: 'primary', size: 'sm', icon: 'plus', label: 'common.new_automation'|trans, href: path('automation_new') }) }}
{% endblock %}
