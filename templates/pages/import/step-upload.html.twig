{#
  PARTIAL · import step 1 · Plik
  Dropzone plus the two escape hatches: a ready-made CSV template and the streaming API.
#}
<div class="wiz-card">
  <h2 class="wiz-title">{{ 'Wgraj plik z klientami'|trans }}</h2>
  <p class="wiz-sub">{{ 'CSV, XML lub Excel. Pierwszy wiersz powinien zawierać nazwy kolumn.'|trans }}</p>

  {{ include('components/molecules/dropzone.html.twig', {
    title: 'Przeciągnij plik tutaj lub kliknij aby wybrać'|trans,
    sub: 'CSV (UTF-8 / ISO-8859-2), XML, XLSX · maks. 50 MB'|trans,
    hint: 'np. newsletter-2026-mar.csv',
    accept: '.csv,.xml,.xlsx'
  }) }}

  <div class="row" style="gap: 14px; margin-top: 18px; align-items: stretch;">
    <div class="card" style="flex:1; padding: 14px;">
      <div class="row" style="gap: 10px;">
        <span style="background: var(--accent-soft); color: var(--accent-soft-fg); width:32px; height:32px; border-radius:8px; display:grid; place-items:center;">
          {{ include('components/atoms/icon.html.twig', { name: 'book' }) }}
        </span>
        <div>
          <div style="font-weight: 500; font-size: 13.5px;">{{ 'Pobierz szablon CSV'|trans }}</div>
          <div class="muted" style="font-size: 12px;">{{ 'Z gotowymi nagłówkami pól które Kivvi rozpoznaje'|trans }}</div>
        </div>
        <span style="margin-left:auto;">{{ include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'download', action: 'download-import-template' }) }}</span>
      </div>
    </div>
    <div class="card" style="flex:1; padding: 14px;">
      <div class="row" style="gap: 10px;">
        <span style="background: var(--brown-soft); color: var(--brown-soft-fg); width:32px; height:32px; border-radius:8px; display:grid; place-items:center;">
          {{ include('components/atoms/icon.html.twig', { name: 'code' }) }}
        </span>
        <div>
          <div style="font-weight: 500; font-size: 13.5px;">{{ 'API importu'|trans }}</div>
          <div class="muted" style="font-size: 12px;">{{ 'Streaming większych zestawów (>50 MB) przez API'|trans }}</div>
        </div>
        <span style="margin-left:auto;">{{ include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'arrow_right', href: path('settings', { tab: 'api' }) }) }}</span>
      </div>
    </div>
  </div>
</div>
