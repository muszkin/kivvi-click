{#
  PARTIAL · import step 2 · validation list

  Params:
    validations (array of {label, tone}, required) — tone "ok" or "info"
#}
<div style="display:grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 24px;">
  {%- for check in validations %}
  <div class="row" style="font-size:13px; gap:8px;{{ check.tone == 'info' ? ' color: var(--fg-muted);' : '' }}">
    {{ include('components/atoms/icon.html.twig', { name: check.tone == 'info' ? 'info' : 'check' }) }}
    <span>{{ check.label|raw }}</span>
  </div>
  {%- endfor %}
</div>
