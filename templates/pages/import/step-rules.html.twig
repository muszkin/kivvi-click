{#
  PARTIAL · import step 3 · Reguły i segmenty
  Dedup strategy, segments (fixed and conditional), and the GDPR consent block.

  Params:
    strategies (array of {value, label, checked}, required)
#}
<div class="wiz-card">
  <h2 class="wiz-title">{{ 'Reguły deduplikacji i segmenty'|trans }}</h2>
  <p class="wiz-sub">{{ 'Zdecyduj jak Kivvi ma postąpić z duplikatami i które segmenty przypisać importowanym klientom.'|trans }}</p>

  <div class="rules-grid">
    {{ include('components/molecules/card.html.twig', {
      title: 'Deduplikacja'|trans, icon: 'users', sub: 'wykryto 4 duplikaty'|trans,
      body: include('pages/import/dedup.html.twig', { strategies: strategies })
    }) }}

    {{ include('components/molecules/card.html.twig', {
      title: 'Segmenty do przypisania'|trans, icon: 'bookmark', sub: 'wszyscy importowani klienci'|trans,
      body: include('pages/import/segments.html.twig')
    }) }}

    {{ include('components/molecules/card.html.twig', {
      class: 'rules-grid__wide',
      title: 'Zgody i prywatność (RODO)'|trans, icon: 'info', sub: 'obowiązkowe pola'|trans,
      body: include('pages/import/consent.html.twig')
    }) }}
  </div>

  <div class="wiz-actions">
    {{ include('components/atoms/button.html.twig', { label: '← Wstecz'|trans, href: path('import', { step: 2 }) }) }}
    <div style="flex:1;"></div>
    {{ include('components/atoms/button.html.twig', { variant: 'primary', label: 'Dalej: podgląd →'|trans, href: path('import', { step: 4 }) }) }}
  </div>
</div>
