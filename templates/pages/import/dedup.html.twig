{#
  PARTIAL · import step 3 · deduplication

  Params:
    strategies (array of {value, label, checked}, required)
#}
<div style="display:flex; flex-direction:column; gap: 12px;">
  <div class="muted" style="font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.06em;">{{ 'Klucz dopasowania'|trans }}</div>
  {{ include('components/molecules/segmented.html.twig', { action: 'set-dedup-key', options: [
    { value: 'email', label: 'Email', active: true },
    { value: 'email_phone', label: 'Email + telefon'|trans },
    { value: 'customer_id', label: 'customer_id' }] }) }}

  <div class="muted" style="font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.06em; margin-top: 6px;">{{ 'Co jeśli klient już istnieje?'|trans }}</div>
  <div class="col" style="gap: 6px;">
    {%- for strategy in strategies %}
      {{ include('components/atoms/toggle-row.html.twig', { kind: 'radio', name: 'dedup', value: strategy.value, label: strategy.label, checked: strategy.checked }) }}
    {%- endfor %}
  </div>

  {{ include('components/molecules/callout.html.twig', {
    text: 'Wyłączasz „Zgoda marketingowa” z nadpisywania — pole będzie zmienione tylko gdy klient nie ma jeszcze zapisanego stanu.'|trans,
    action: include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'edit', action: 'edit-consent-rule' })
  }) }}
</div>
