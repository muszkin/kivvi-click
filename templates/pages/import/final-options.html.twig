{#
  PARTIAL · import step 4 · final options
  What happens after the import finishes, and whether the mapping is saved as a template.
#}
<div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px;">
  <div>
    {{ include('components/atoms/toggle-row.html.twig', {
      name: 'send_report', checked: true,
      label: '<strong>' ~ 'Wyślij raport po imporcie'|trans ~ '</strong> ' ~ 'na'|trans ~ ' <span class="mono">' ~ panel.user.email ~ '</span>'
    }) }}
    {{ include('components/atoms/toggle-row.html.twig', {
      name: 'save_mapping', checked: true,
      label: '<strong>' ~ 'Zapisz mapowanie'|trans ~ '</strong> ' ~ 'jako szablon — przyspiesza kolejne importy'|trans
    }) }}
    {{ include('components/atoms/toggle-row.html.twig', {
      name: 'run_welcome', checked: false,
      label: '<strong>' ~ 'Uruchom automatyzację powitalną'|trans ~ '</strong> ' ~ 'dla nowych klientów z opt-in'|trans
    }) }}
  </div>
  <div>
    {{ include('components/atoms/field.html.twig', { name: 'mapping_template', label: 'Nazwa szablonu mapowania'|trans, value: 'Import z Shoper · marzec 2026' }) }}
    <label class="label" style="margin-top: 12px;">{{ 'Harmonogram'|trans }}</label>
    {{ include('components/molecules/segmented.html.twig', { action: 'set-import-schedule', options: [
      { value: 'now', label: 'Uruchom teraz'|trans, active: true },
      { value: 'later', label: 'Zaplanuj'|trans }] }) }}
  </div>
</div>
