{#
  PARTIAL · import step 4 · Podgląd i start
  Summary tiles, the first rows after mapping, final options and the CTA that counts rows.

  Params:
    summary (array of kpi-tile param hashes, required)
    preview (array of preview rows, required)
    row_count (int, required)
    error_count (int, required)
#}
<div class="wiz-card">
  <div class="row" style="justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 6px;">
    <div>
      <h2 class="wiz-title">{{ 'Podgląd i uruchomienie'|trans }}</h2>
      <p class="wiz-sub">{{ 'Sprawdź jak będzie wyglądał import. Wszystko OK? Wciśnij Uruchom import — błędy zostaną pominięte.'|trans }}</p>
    </div>
    {{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'download', label: 'Pobierz raport walidacji (CSV)'|trans, action: 'export' }) }}
  </div>

  <div style="margin: 14px 0;">
    {{ include('components/organisms/kpi-grid.html.twig', { tiles: summary }) }}
  </div>

  {% set tableColumns = [
    { label: 'Status'|trans }, { label: 'Email'|trans }, { label: 'Imię i nazwisko'|trans }, { label: 'Opt-in'|trans },
    { label: 'Zam.'|trans, align: 'right' }, { label: 'LTV'|trans, align: 'right' }, { label: 'Segmenty'|trans }, { label: '' }
  ] %}
  {% set rows = [] %}
  {% for r in preview %}
    {% set segments = '' %}
    {% for s in r.segments %}{% set segments = segments ~ include('components/atoms/chip.html.twig', { label: s }) %}{% endfor %}
    {% set rows = rows|merge([[
      include('components/atoms/chip.html.twig', { label: r.statusLabel, tone: r.statusTone }),
      '<span class="mono" style="font-size:12px;">' ~ r.email ~ '</span>',
      r.name,
      r.optIn,
      '<span class="mono">' ~ r.orders ~ '</span>',
      '<span class="mono">' ~ r.ltv ~ '</span>',
      segments,
      r.error ? '<span style="color: var(--bad); font-size:12px;">' ~ r.error ~ '</span>' : ''
    ]]) %}
  {% endfor %}

  {{ include('components/molecules/card.html.twig', {
    title: 'Podgląd pierwszych %count% wierszy'|trans({ '%count%': preview|length }), icon: 'eye',
    sub: 'po zastosowaniu mapowania i reguł'|trans,
    headActions: include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', label: 'Wszystkie'|trans, action: 'filter-preview', payload: 'all', attrs: { 'data-active': 'true' } })
               ~ include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', label: 'Tylko błędy (%count%)'|trans({ '%count%': error_count }), action: 'filter-preview', payload: 'errors' }),
    raw: include('components/molecules/table.html.twig', { columns: tableColumns, rows: rows, scroll: true })
  }) }}

  <div style="margin-top:16px;">
    {{ include('components/molecules/card.html.twig', { body: include('pages/import/final-options.html.twig') }) }}
  </div>

  <div class="wiz-actions">
    {{ include('components/atoms/button.html.twig', { label: '← Wstecz'|trans, href: path('import', { step: 3 }) }) }}
    <div style="flex:1;"></div>
    {{ include('components/atoms/button.html.twig', { icon: 'edit', label: 'Edytuj mapowanie'|trans, href: path('import', { step: 2 }) }) }}
    {{ include('components/atoms/button.html.twig', {
      variant: 'primary', size: 'lg', icon: 'upload',
      label: 'Uruchom import %count% klientów →'|trans({ '%count%': row_count|number_format(0, ',', ' ') }),
      action: 'run-import'
    }) }}
  </div>
</div>
