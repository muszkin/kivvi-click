{#
  PARTIAL · import step 2 · Mapowanie kolumn
  Auto-detection summary, one map-row per file column, and what validation will run.

  Params:
    file (hash {name, meta}, required)
    columns (array of map-row param hashes, required)
    detection (hash {recognised, total, sure, unsure, skipped}, required)
    validations (array of {label, tone}, required)
#}
<div class="wiz-card">
  <div class="row" style="justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 6px;">
    <div>
      <h2 class="wiz-title">{{ 'Mapowanie kolumn'|trans }}</h2>
      <p class="wiz-sub">{{ 'Sprawdź jak kolumny z pliku odpowiadają polom w Kivvi. Możesz zmienić każde mapowanie ręcznie.'|trans }}</p>
    </div>
    <div class="file-pill">
      {{ include('components/atoms/icon.html.twig', { name: 'upload' }) }}
      <div>
        <div style="font-weight: 500; font-size: 13px;">{{ file.name }}</div>
        <div class="muted mono" style="font-size: 11px;">{{ file.meta }}</div>
      </div>
      {{ include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', label: 'Zmień'|trans, href: path('import', { step: 1 }) }) }}
    </div>
  </div>

  <div class="auto-detect">
    <div class="row" style="gap:8px;">
      {{ include('components/atoms/icon.html.twig', { name: 'spark' }) }}
      <span>
        <strong>{{ 'Kivvi rozpoznał %recognised% z %total% kolumn automatycznie.'|trans({ '%recognised%': detection.recognised, '%total%': detection.total }) }}</strong>
        {{ 'Sprawdź żółte i czerwone — wymagają decyzji.'|trans }}
      </span>
      <div style="margin-left:auto; display:flex; gap:6px;">
        {{ include('components/atoms/chip.html.twig', { label: detection.sure ~ ' ' ~ 'pewne'|trans, tone: 'good' }) }}
        {{ include('components/atoms/chip.html.twig', { label: detection.unsure ~ ' ' ~ 'niepewne'|trans, tone: 'warn' }) }}
        {{ include('components/atoms/chip.html.twig', { label: detection.skipped ~ ' ' ~ 'pominięte'|trans }) }}
      </div>
    </div>
  </div>

  <div class="map-table">
    <div class="map-row map-row--head">
      <div>{{ 'Kolumna w pliku'|trans }}</div>
      <div>{{ 'Przykładowe wartości'|trans }}</div>
      <div>{{ 'Pole w Kivvi'|trans }}</div>
      <div class="right">{{ 'Pewność'|trans }}</div>
    </div>
    {%- for column in columns %}{{ include('components/molecules/map-row.html.twig', column) }}{% endfor %}
  </div>

  {{ include('components/molecules/card.html.twig', {
    class: 'wiz-validation',
    title: 'Walidacja danych'|trans, icon: 'check', sub: 'co Kivvi sprawdzi podczas importu'|trans,
    body: include('pages/import/validation-list.html.twig', { validations: validations })
  }) }}

  <div class="wiz-actions">
    {{ include('components/atoms/button.html.twig', { label: '← Wstecz'|trans, href: path('import', { step: 1 }) }) }}
    <div style="flex:1;"></div>
    {{ include('components/atoms/button.html.twig', { variant: 'primary', label: 'Dalej: reguły →'|trans, href: path('import', { step: 3 }) }) }}
  </div>
</div>
