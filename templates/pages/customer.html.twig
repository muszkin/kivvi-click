{#
  PAGE · Profil klienta (360)
  Route: GET /{_locale}/customers/{id}
  Purpose: Everything known about one customer plus their activity axis.

  Structure:
    page-head with back link
    customer-grid 320px/1fr
    left: profile-card (avatar, chips, profile-fact list) + active automations card
    right: tab strip, kpi-grid x3 (engagement, purchase probability, open rate), timeline card
#}
{% extends 'layout/app.html.twig' %}
{% block content %}
<div class="page">
  {{ include('components/organisms/page-head.html.twig', {
    title: customer.name, sub: profile_sub,
    back: { label: '← Powrót do listy'|trans, route: path('customers') }, actions: block('actions')
  }) }}

  <div class="customer-grid">
    <div class="col" style="gap:16px;">
      <div class="profile-card">
        <div class="profile-avatar">{{ customer.initials }}</div>
        <h2 class="profile-name">{{ customer.name }}</h2>
        <p class="muted" style="margin: 4px 0 14px; font-size: 13px;">{{ customer.email }}</p>
        <div class="row" style="gap:4px;">
          {%- for c in customer.tags %}{{ include('components/atoms/chip.html.twig', c) }}{% endfor %}
        </div>
        <div style="margin-top: 18px;">
          {%- for fact in facts %}{{ include('components/molecules/profile-fact.html.twig', fact) }}{% endfor %}
        </div>
      </div>

      {{ include('components/molecules/card.html.twig', {
        title: 'Aktywne automatyzacje'|trans,
        raw: include('pages/customers/active-automations.html.twig', { automations: automations })
      }) }}
    </div>

    <div class="col" style="gap:16px;">
      {{ include('components/molecules/tabs.html.twig', { tabs: tabs }) }}
      {{ include('components/organisms/kpi-grid.html.twig', { tiles: scores, columns: 3 }) }}
      {{ include('components/molecules/card.html.twig', {
        title: 'Oś czasu'|trans, icon: 'activity', sub: 'ostatnie 24 godziny'|trans,
        headActions: include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'filter', label: 'Filtry'|trans, action: 'open-filters' }),
        body: include('pages/customers/timeline.html.twig', { timeline: timeline })
      }) }}
    </div>
  </div>
</div>
{% endblock %}

{% block actions %}
  {{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'mail', label: 'Wyślij email'|trans, action: 'send-email', payload: customer.id }) }}
  {{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'coupon', label: 'Daj kupon'|trans, action: 'grant-coupon', payload: customer.id }) }}
  {{ include('components/atoms/button.html.twig', { size: 'sm', icon: 'bookmark', label: 'Dodaj do segmentu'|trans, action: 'add-to-segment', payload: customer.id }) }}
{% endblock %}
