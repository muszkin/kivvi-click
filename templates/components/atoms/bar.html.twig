{#
  ATOM · bar
  Horizontal usage/coverage bar. Used in feeds matching, API limits, plan usage.

  Params:
    label (string, required)
    pct   (float, required) — 0–100 fill width
    value (string) — right-aligned readout
    tone  (enum: accent|brown|bad) default "accent"
    labelWidth (int) default 170

  Usage:
    {{ include('components/atoms/bar.html.twig', { label: 'Po id', pct: 78, value: '78%' }) }}
#}
{%- set _tone = { accent: 'var(--accent)', brown: 'var(--brown)', bad: 'var(--bad)' } -%}
{%- set _isBad = tone|default('accent') == 'bad' -%}
<div class="bar-row">
  <span style="width:{{ labelWidth|default(170) }}px; font-size:12.5px;{{ _isBad ? ' color: var(--bad);' : '' }}">{{ label }}</span>
  <div class="bar"><div class="bar-fill" style="width: {{ pct }}%; background: {{ _tone[tone|default('accent')] }};"></div></div>
  {%- if value is defined %}<span class="mono" style="font-size:12px; min-width:90px; text-align:right;{{ _isBad ? ' color: var(--bad);' : '' }}">{{ value }}</span>{% endif %}
</div>
