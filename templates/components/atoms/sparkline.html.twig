{#
  ATOM · sparkline
  Inline SVG trend line with area fill. Server-rendered from a value array — no JS.

  Params:
    values (array of float, required)
    w (int) default 240, h (int) default 38
    stroke (string) default "var(--accent)"
    fill   (string) default "var(--accent-soft)"

  Usage:
    {{ include('components/atoms/sparkline.html.twig', { values: series }) }}
#}
{%- set _w = w|default(240) -%}{%- set _h = h|default(38) -%}
{%- set _max = values|reduce((c, v) => max(c, v), values|first) -%}
{%- set _min = values|reduce((c, v) => min(c, v), values|first) -%}
{%- set _range = (_max - _min) ?: 1 -%}
{%- set _step = _w / (values|length - 1) -%}
{%- set _pts = [] -%}
{%- for i, v in values -%}
  {%- set _pts = _pts|merge([(i * _step)|round(1) ~ ',' ~ (_h - ((v - _min) / _range) * (_h - 4) - 2)|round(1)]) -%}
{%- endfor -%}
{%- set _path = 'M' ~ _pts|join(' L') -%}
<svg viewBox="0 0 {{ _w }} {{ _h }}" preserveAspectRatio="none" width="100%" height="100%" aria-hidden="true">
  <path d="{{ _path }} L{{ _w }},{{ _h }} L0,{{ _h }} Z" fill="{{ fill|default('var(--accent-soft)') }}" opacity="0.5"/>
  <path d="{{ _path }}" stroke="{{ stroke|default('var(--accent)') }}" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
