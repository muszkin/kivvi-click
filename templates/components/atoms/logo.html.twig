{#
  ATOM · logo
  Kiwi bird mark. Body uses currentColor, beak uses --brown, leaf uses --accent.

  Params:
    size (int) default 22 — height in px; width is 1.4×
    mono (bool) — single-colour silhouette for favicons/tight spaces

  Usage:
    <span style="color: var(--accent);">{{ include('components/atoms/logo.html.twig', { size: 28 }) }}</span>
#}
{%- set s = size|default(22) -%}
<svg width="{{ (s * 1.4)|round }}" height="{{ s }}" viewBox="0 0 56 40" aria-hidden="true">
  <ellipse cx="34" cy="24" rx="18" ry="14" fill="currentColor"/>
  <polygon points="16,25 -2,21 16,29" fill="{{ mono|default(false) ? 'currentColor' : 'var(--brown)' }}"/>
  <circle cx="40" cy="20" r="1.8" fill="var(--bg-card)"/>
  {%- if not mono|default(false) %}
  <circle cx="40.4" cy="19.7" r="0.7" fill="currentColor"/>
  <rect x="28" y="36" width="1.6" height="4" rx="0.6" fill="var(--brown)"/>
  <rect x="36" y="36" width="1.6" height="4" rx="0.6" fill="var(--brown)"/>
  <circle cx="48" cy="13" r="2.2" fill="var(--accent)"/>
  {%- endif %}
</svg>
