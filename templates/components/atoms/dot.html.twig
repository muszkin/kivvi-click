{#
  ATOM · dot
  6px status dot. `live` wraps it so the CSS ::after pulse ring has a positioning context.

  Params:
    color (string) — CSS color; defaults to currentColor
    live  (bool)   — animated pulse ring (1.6s ease-in-out infinite)

  Usage:
    {{ include('components/atoms/dot.html.twig', { live: true }) }}
#}
{%- if live|default(false) -%}
<span class="dot-wrap"><span class="dot live"{% if color is defined %} style="background: {{ color }};"{% endif %}></span></span>
{%- else -%}
<span class="dot"{% if color is defined %} style="background: {{ color }};"{% endif %}></span>
{%- endif -%}
