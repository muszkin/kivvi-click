{#
  ATOM · field
  Labelled form control. Focus ring is 3px var(--accent-soft) + accent border.

  Params:
    type    (enum: text|password|email|number|select|textarea) default "text"
    name    (string, required)
    label   (string)
    value   (string)
    placeholder (string)
    options (array of {value,label,selected}) — select only
    rows    (int) default 3 — textarea only
    mono    (bool) — monospace value (codes, keys, amounts)
    help    (string) — hint under the control
    error   (string) — error text; adds aria-invalid

  Usage:
    {{ include('components/atoms/field.html.twig', { name: 'sender', label: 'Nadawca', value: 'sklep@aureashop.pl', mono: true }) }}
#}
{%- set t = type|default('text') -%}
<div class="field-row">
  {%- if label is defined %}<label class="label" for="f-{{ name }}">{{ label }}</label>{% endif %}
  {%- if t == 'select' %}
    <select class="select {{ mono|default(false) ? 'mono' : '' }}" id="f-{{ name }}" name="{{ name }}"
            {% if error is defined %}aria-invalid="true"{% endif %}>
      {%- for o in options|default([]) %}
        <option value="{{ o.value }}"{{ o.selected|default(false) ? ' selected' : '' }}>{{ o.label }}</option>
      {%- endfor %}
    </select>
  {%- elseif t == 'textarea' %}
    <textarea class="textarea {{ mono|default(false) ? 'mono' : '' }}" id="f-{{ name }}" name="{{ name }}"
              rows="{{ rows|default(3) }}" placeholder="{{ placeholder|default('') }}">{{ value|default('') }}</textarea>
  {%- else %}
    <input class="input {{ mono|default(false) ? 'mono' : '' }}" id="f-{{ name }}" name="{{ name }}" type="{{ t }}"
           value="{{ value|default('') }}" placeholder="{{ placeholder|default('') }}"
           {% if error is defined %}aria-invalid="true"{% endif %}>
  {%- endif %}
  {%- if help is defined %}<div class="muted" style="font-size:12px; margin-top:4px;">{{ help }}</div>{% endif %}
  {%- if error is defined %}<div style="color: var(--bad); font-size:12px; margin-top:4px;">{{ error }}</div>{% endif %}
</div>
