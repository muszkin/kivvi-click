{#
  ATOM · wordmark
  Logo + "kivvi·click" lockup. The middle dot is a --brown square, not a glyph.

  Params:
    size (int) default 22 — logo height
    fontSize (int) default 22

  Usage:
    {{ include('components/atoms/wordmark.html.twig', {}, false) }}
#}
<div class="row" style="gap: 10px;">
  <span style="color: var(--accent); display: inline-flex; align-items: center;">
    {{ include('components/atoms/logo.html.twig', { size: size|default(22) }, false) }}
  </span>
  <span class="brand-name" style="font-size: {{ fontSize|default(22) }}px;">kivvi<span class="brand-dot"></span>click</span>
