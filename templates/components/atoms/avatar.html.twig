{#
  ATOM · avatar
  Initials circle. No images in this system — initials on --brown.

  Params:
    name (string, required) — full name; first letters of first two words are used
    size (int) default 30
    text (string) — override the computed initials

  Usage:
    {{ include('components/atoms/avatar.html.twig', { name: 'Maciej Kowalczyk', size: 48 }) }}
#}
{%- set _s = size|default(30) -%}
{%- set _init = text|default(name|split(' ')|slice(0,2)|map(w => w|first)|join|upper) -%}
<span class="avatar" style="width:{{ _s }}px; height:{{ _s }}px; font-size:{{ (_s * 0.4)|round }}px;">{{ _init }}</span>
