{#
  ATOM · button
  Primary interactive control. One element, five variants, three sizes.

  Params:
    label    (string) — visible text; omit for icon-only
    variant  (enum: default|primary|ghost|danger) default "default"
    size     (enum: sm|md|lg) default "md"
    icon     (string) — leading icon name
    iconEnd  (string) — trailing icon name
    action   (string) — data-action value consumed by app.ts delegation
    payload  (string) — data-payload value
    href     (string) — renders <a> instead of <button>
    disabled (bool)
    attrs    (hash)  — extra HTML attributes

  Usage:
    {{ include('components/atoms/button.html.twig', { label: 'Opublikuj', variant: 'primary', icon: 'play' }) }}
#}
{%- set tag = href is defined ? 'a' : 'button' -%}
{%- set classes = ['btn', variant|default('default') != 'default' ? variant : '', size|default('md') != 'md' ? size : '']|filter(v => v) -%}
<{{ tag }} class="{{ classes|join(' ') }}"
  {%- if href is defined %} href="{{ href }}"{% else %} type="{{ type|default('button') }}"{% endif %}
  {%- if action is defined %} data-action="{{ action }}"{% endif %}
  {%- if payload is defined %} data-payload="{{ payload }}"{% endif %}
  {%- if disabled|default(false) %} disabled aria-disabled="true"{% endif %}
  {%- for k, v in attrs|default({}) %} {{ k }}="{{ v }}"{% endfor %}>
  {%- if icon is defined %}{{ include('components/atoms/icon.html.twig', { name: icon }, false) }}{% endif %}
  {%- if label is defined %}<span>{{ label }}</span>{% endif %}
  {%- if iconEnd is defined %}{{ include('components/atoms/icon.html.twig', { name: iconEnd }, false) }}{% endif %}
</{{ tag }}>
