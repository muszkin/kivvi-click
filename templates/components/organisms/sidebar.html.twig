{#
  ORGANISM · sidebar
  Fixed left rail: wordmark, workspace switcher, grouped nav, user footer. Collapsed state is driven by [data-sidebar="collapsed"] on .app — the grid column animates 248px → 64px over 220ms and every label is display:none.

  Params:
    groups (array of {section,label,items[]}, required) — items use the nav-item contract
    current (string, required) — active route key
    workspace (hash) — name, meta, mark
    user (hash) — name, email

  Usage:
    {{ include('components/organisms/sidebar.html.twig', { groups: nav, current: 'dashboard' }) }}
#}
<aside class="sidebar">
  <div class="brand-row">{{ include('components/atoms/wordmark.html.twig', {}, false) }}</div>

  {%- if workspace is defined %}
    {{ include('components/molecules/workspace-card.html.twig', workspace, false) }}
  {%- endif %}

  <nav class="nav scrollable" aria-label="Nawigacja główna">
    {%- for g in groups %}
    <div class="nav-group">
      <div class="nav-section-label">{{ g.label }}</div>
      {%- for it in g.items %}
        {{ include('components/molecules/nav-item.html.twig', it|merge({ active: it.route == current }), false) }}
      {%- endfor %}
    </div>
    {%- endfor %}
  </nav>

  {%- if user is defined %}
  <div class="sb-foot">
    {{ include('components/atoms/avatar.html.twig', { name: user.name }, false) }}
    <div style="min-width:0; flex:1;">
      <div style="font-size:12.5px; font-weight:500; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{ user.name }}</div>
      <div style="font-size:11px; color:var(--fg-muted);">{{ user.email }}</div>
    </div>
  </div>
  {%- endif %}
</aside>
