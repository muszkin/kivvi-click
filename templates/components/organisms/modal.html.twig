{#
  ORGANISM · modal
  Centred dialog on a 45% scrim. Escape and scrim click both close; trap focus inside while open.

  Params:
    title (string, required)
    body (html, required)
    foot (html)
    size (int) default 560

  Usage:
    {{ include('components/organisms/modal.html.twig', { title: 'Podłącz feed', body: form }) }}
#}
<div class="scrim" data-action="close-modal" data-controller="modal">
  <div class="modal" role="dialog" aria-modal="true" aria-label="{{ title }}"
       {% if size is defined %}style="max-width: {{ size }}px;"{% endif %}
       data-modal-target="panel">
    <div class="modal-head">
      <h3 class="card-title">{{ title }}</h3>
      <div style="margin-left:auto;">
        {{ include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'x', action: 'close-modal', attrs: { 'aria-label': 'Zamknij' } }, false) }}
      </div>
    </div>
    <div class="modal-body">{{ body|raw }}</div>
    {%- if foot is defined %}<div class="modal-foot">{{ foot|raw }}</div>{% endif %}
  </div>
</div>
