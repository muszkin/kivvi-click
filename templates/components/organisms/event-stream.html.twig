{#
  ORGANISM · event-stream
  Live feed container. Server-render the first page; app.ts subscribes to Mercure and prepends rows with class "new" (800ms flash-in), trimming past `limit`.

  Params:
    events (array of event-row param hashes, required)
    id (string) default "event-stream" — Mercure target
    topic (string) — Mercure topic, e.g. "/accounts/1/events"

  Usage:
    {{ include('components/organisms/event-stream.html.twig', { events: events, topic: mercureTopic }) }}
#}
<div class="event-stream" id="{{ id|default('event-stream') }}"
     {% if topic is defined %}data-controller="event-stream" data-event-stream-topic="{{ topic }}"{% endif %}
     aria-live="polite" aria-relevant="additions">
  {%- for ev in events %}{{ include('components/molecules/event-row.html.twig', ev, false) }}{% endfor %}
</div>
