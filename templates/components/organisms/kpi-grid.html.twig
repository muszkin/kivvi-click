{#
  ORGANISM · kpi-grid
  4-up metric row, 2-up under 1100px.

  Params:
    tiles (array of kpi-tile param hashes, required)
    columns (int) default 4

  Usage:
    {{ include('components/organisms/kpi-grid.html.twig', { tiles: tiles }) }}
#}
{# `columns` is a tile count; ignore anything else the surrounding page may have bound to that name. #}
<div class="kpi-grid"{% if columns is defined and columns is not iterable %} style="grid-template-columns: repeat({{ columns }}, minmax(0, 1fr));"{% endif %}>
  {%- for t in tiles %}{{ include('components/molecules/kpi-tile.html.twig', t, false) }}{% endfor %}
</div>
