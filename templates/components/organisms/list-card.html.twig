{#
  ORGANISM · list-card
  The 4-column summary row used by automation and popup lists: title + meta chips, then three right-aligned metrics.

  Params:
    title (string, required)
    chips (array of chip param hashes)
    metrics (array of {value,label,color})
    actions (html)
    action (string), payload (string) — whole-row click

  Usage:
    {{ include('components/organisms/list-card.html.twig', { title: 'Powrót do koszyka', metrics: m }) }}
#}
<div class="auto-card"{% if action is defined %} data-action="{{ action }}" data-payload="{{ payload|default('') }}"{% endif %}>
  <div>
    <div class="auto-card__title">{{ title }}</div>
    {%- if chips is defined %}
    <div class="auto-card__meta">
      {%- for c in chips %}{{ include('components/atoms/chip.html.twig', c, false) }}{% endfor %}
    </div>
    {%- endif %}
  </div>
  {%- for m in metrics|default([]) %}
  <div class="auto-card__num right" style="min-width:{{ m.width|default(90) }}px;{% if m.color is defined %} color: {{ m.color }};{% endif %}">
    {{ m.value }}<span class="sub">{{ m.label }}</span>
  </div>
  {%- endfor %}
  {%- if actions is defined %}<div class="row" style="gap:4px;">{{ actions|raw }}</div>{% endif %}
</div>
