{#
  ORGANISM · editor-shell
  Three-pane WYSIWYG frame shared by the email and popup editors: 280px library · fluid canvas · 280px inspector. The inspector is hidden under 1300px.

  Params:
    leftTitle (string), leftIcon (string), left (html, required)
    canvas (html, required)
    rightTitle (string), rightIcon (string), right (html)

  Usage:
    {{ include('components/organisms/editor-shell.html.twig', { leftTitle: 'Bloki', left: lib, canvas: doc, right: props }) }}
#}
<div class="email-editor">
  <div class="ee-panel">
    <div class="ee-panel-head">{% if leftIcon is defined %}{{ include('components/atoms/icon.html.twig', { name: leftIcon }, false) }}{% endif %} {{ leftTitle|default('Bloki') }}</div>
    <div class="ee-panel-body">{{ left|raw }}</div>
  </div>

  <div class="ee-canvas-wrap scrollable">{{ canvas|raw }}</div>

  {%- if right is defined %}
  <div class="ee-panel email-right">
    <div class="ee-panel-head">{{ include('components/atoms/icon.html.twig', { name: rightIcon|default('sliders') }, false) }} {{ rightTitle|default('Właściwości') }}</div>
    <div class="ee-panel-body">{{ right|raw }}</div>
  </div>
  {%- endif %}
</div>
