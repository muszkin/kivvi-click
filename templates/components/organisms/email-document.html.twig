{#
  ORGANISM · email-document
  The 600px email canvas. Deliberately uses hard-coded oklch() literals, not tokens — email clients do not inherit the app theme and must never render dark.

  Params:
    sections (array of block hashes, required) — each has type: hero|coupon|products|text|footer
    hero (hash), coupon (hash), products (array), footer (string)

  Usage:
    {{ include('components/organisms/email-document.html.twig', { hero: hero, products: products }) }}
#}
<div class="ee-doc">
  {%- for s in sections %}
    {%- if s.type == 'hero' %}
      <div class="doc-hero">
        {%- if s.kicker is defined %}<div class="mono" style="font-size: 11px; letter-spacing: 0.15em; color: oklch(0.5 0.03 90);">{{ s.kicker }}</div>{% endif %}
        <div class="doc-h">{{ s.title }}</div>
        {%- if s.body is defined %}<div style="color: oklch(0.45 0.025 150); font-size: 14px;">{{ s.body|raw }}</div>{% endif %}
      </div>
    {%- elseif s.type == 'coupon' %}
      <div class="doc-section" style="text-align:center;">
        {{ include('components/molecules/coupon-code.html.twig', { code: s.code, note: s.note|default(null) }, false) }}
        <a class="doc-cta" href="{{ s.href|default('#') }}">{{ s.cta }}</a>
      </div>
    {%- elseif s.type == 'products' %}
      <div class="doc-section">
        {%- if s.kicker is defined %}<div class="mono" style="font-size: 11px; letter-spacing: 0.15em; color: oklch(0.5 0.03 90);">{{ s.kicker }}</div>{% endif %}
        <div class="doc-prod">
          {%- for p in s.items %}
          <div class="item">
            <div class="ph"></div>
            <div style="font-weight: 500; font-size: 13px;">{{ p.name }}</div>
            <div style="color: oklch(0.5 0.025 150); font-size: 12px;">{{ p.price }}</div>
          </div>
          {%- endfor %}
        </div>
      </div>
    {%- elseif s.type == 'footer' %}
      <div class="doc-foot">{{ s.body|raw }}</div>
    {%- endif %}
  {%- endfor %}
</div>
