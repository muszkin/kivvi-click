{#
  ORGANISM · popup-stage
  Widget preview on a mock storefront. min-height (480 desktop / 620 mobile) is load-bearing: without it the aspect-ratio box collapses under the widget and overflow:hidden clips it.

  Params:
    type (enum: modal|slide-in|banner|fullscreen|toast, required)
    device (enum: desktop|mobile) default desktop
    widget (html, required) — the .pw element

  Usage:
    {{ include('components/organisms/popup-stage.html.twig', { type: 'modal', device: 'desktop', widget: w }) }}
#}
<div class="pw-stage" data-device="{{ device|default('desktop') }}" data-type="{{ type }}">
  <div class="shop-mock" aria-hidden="true">
    <div class="shop-mock__bar">
      <span class="shop-mock__logo">aureashop</span>
      <span class="shop-mock__nav"></span><span class="shop-mock__nav"></span><span class="shop-mock__nav"></span>
      <span class="shop-mock__cart"></span>
    </div>
    <div class="shop-mock__hero"></div>
    <div class="shop-mock__grid"><span></span><span></span><span></span><span></span></div>
  </div>
  <div class="pw-dim"></div>
  {{ widget|raw }}
</div>
