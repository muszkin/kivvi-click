{#
  ORGANISM · block-library
  2-column grid of draggable block sources for the editors. cursor: grab; wire HTML5 drag in editor.ts.

  Params:
    blocks (array of {icon,label,type}, required)

  Usage:
    {{ include('components/organisms/block-library.html.twig', { blocks: blocks }) }}
#}
<div class="ee-block-lib">
  {%- for b in blocks %}
  <button draggable="true" data-block-type="{{ b.type|default(b.label|lower) }}">
    {{ include('components/atoms/icon.html.twig', { name: b.icon }, false) }} {{ b.label }}
  </button>
  {%- endfor %}
</div>
