{#
  ORGANISM · page-head
  Page title block. The serif italic title needs line-height ≥1.15 and padding-bottom ≥0.08em or descenders clip.

  Params:
    title (string, required)
    sub (string)
    actions (html) — right-aligned slot
    back (hash) — {label, route} where route is a generated URL

  Usage:
    {{ include('components/organisms/page-head.html.twig', { title: 'Klienci', sub: '…', actions: buttons }) }}
#}
<div class="page-head">
  <div>
    {%- if back is defined %}
      {{ include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', label: back.label, href: back.route, attrs: { style: 'margin-bottom: 6px;' } }, false) }}
    {%- endif %}
    <h1 class="page-title">{{ title }}</h1>
    {%- if sub is defined %}<p class="page-sub">{{ sub|raw }}</p>{% endif %}
  </div>
  {%- if actions is defined %}<div class="page-actions">{{ actions|raw }}</div>{% endif %}
</div>
