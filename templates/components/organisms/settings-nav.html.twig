{#
  ORGANISM · settings-nav
  220px settings sidebar. Stacks above the panel under 1000px.

  Params:
    tabs (array of {id,icon,label}, required)
    current (string, required)

  Usage:
    {{ include('components/organisms/settings-nav.html.twig', { tabs: tabs, current: 'sites' }) }}
#}
<nav class="settings-nav" aria-label="Sekcje ustawień">
  {%- for t in tabs %}
  <a href="{{ path('settings', { tab: t.id }) }}" aria-current="{{ t.id == current ? 'true' : 'false' }}">
    {{ include('components/atoms/icon.html.twig', { name: t.icon }, false) }} <span>{{ t.label }}</span>
  </a>
  {%- endfor %}
</nav>
