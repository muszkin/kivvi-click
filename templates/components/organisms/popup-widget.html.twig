{#
  ORGANISM · popup-widget
  The widget itself, in five shapes. Like the email document it uses literal colours — it renders on the customer’s storefront, outside our theme.

  Params:
    type (enum: modal|slide-in|banner|fullscreen|toast, required)
    kicker (string), title (string, required), body (string)
    placeholder (string), cta (string), fine (string)

  Usage:
    {{ include('components/organisms/popup-widget.html.twig', { type: 'modal', title: 'Zostań na 10% taniej', cta: 'Wyślij mi kupon →' }) }}
#}
{%- set cls = { 'modal': 'pw--modal', 'slide-in': 'pw--slidein', 'banner': 'pw--banner', 'fullscreen': 'pw--fullscreen', 'toast': 'pw--toast' } -%}
<div class="pw {{ cls[type] }}" role="dialog" aria-label="{{ title }}">
  <button class="pw-close" data-action="dismiss-widget" aria-label="Zamknij">{{ include('components/atoms/icon.html.twig', { name: 'x' }, false) }}</button>
  {%- if type == 'banner' %}
    <div class="pw-banner-row">
      <div>
        {%- if kicker is defined %}<div class="mono pw-kicker">{{ kicker }}</div>{% endif %}
        <div class="pw-title" style="font-size:19px; margin:2px 0 0;">{{ title }}</div>
      </div>
      <button class="pw-cta" style="width:auto; white-space:nowrap;">{{ cta }}</button>
    </div>
  {%- elseif type == 'toast' %}
    <div class="row" style="gap:10px; align-items:flex-start;">
      <span class="pw-toast-dot"></span>
      <div>
        <div style="font-weight:600; font-size:13px;">{{ title }}</div>
        {%- if body is defined %}<div style="font-size:12.5px; opacity:0.75;">{{ body }}</div>{% endif %}
      </div>
    </div>
  {%- else %}
    {%- if kicker is defined %}<div class="mono pw-kicker">{{ kicker }}</div>{% endif %}
    <h3 class="pw-title">{{ title }}</h3>
    {%- if body is defined and type != 'slide-in' %}<p class="pw-sub">{{ body }}</p>{% endif %}
    <form class="pw-form" data-action="submit-widget">
      {%- if placeholder is defined %}<input class="pw-input" type="email" name="email" placeholder="{{ placeholder }}" required>{% endif %}
      <button class="pw-cta" type="submit">{{ cta }}</button>
    </form>
    {%- if fine is defined %}<div class="pw-fine">{{ fine }}</div>{% endif %}
  {%- endif %}
</div>
