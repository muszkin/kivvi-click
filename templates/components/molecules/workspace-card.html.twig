{#
  MOLECULE · workspace-card
  Account/site switcher at the top of the sidebar. Collapses to just the 28px mark.

  Params:
    name (string, required)
    meta (string) — e.g. "Plan Pro · 3 strony"
    mark (string) — 2-letter badge

  Usage:
    {{ include('components/molecules/workspace-card.html.twig', { name: 'aureashop.pl', meta: 'Plan Pro · 3 strony', mark: 'AS' }) }}
#}
<button class="ws-card" data-action="open-workspace-switcher" title="{{ name }}">
  <span class="ws-mark">{{ mark }}</span>
  <span class="ws-label">
    <span class="ws-name">{{ name }}</span>
    <span class="ws-meta">{{ meta }}</span>
  </span>
  {{ include('components/atoms/icon.html.twig', { name: 'chevron_d', class: 'nav-icon' }, false) }}
</button>
