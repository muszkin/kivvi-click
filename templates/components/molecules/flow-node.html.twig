{#
  MOLECULE · flow-node
  Absolutely-positioned node on the rule flow canvas. Border colour encodes the node class.

  Params:
    x (int, required), y (int, required) — px within the canvas
    kind (enum: trigger|cond|action, required)
    kicker (string, required)
    title (string, required)
    sub (string) — mono expression
    icon (string)

  Usage:
    {{ include('components/molecules/flow-node.html.twig', { x: 30, y: 40, kind: 'trigger', kicker: 'KIEDY', title: 'Porzucenie koszyka', sub: 'cart_abandon', icon: 'cart' }) }}
#}
<div class="flow-node {{ kind }}" style="left: {{ x }}px; top: {{ y }}px;" data-flow-node>
  <div class="flow-node__kicker">{% if icon is defined %}{{ include('components/atoms/icon.html.twig', { name: icon }, false) }}{% endif %} {{ kicker }}</div>
  <div class="flow-node__title">{{ title }}</div>
  {%- if sub is defined %}<div class="flow-node__sub">{{ sub }}</div>{% endif %}
</div>
