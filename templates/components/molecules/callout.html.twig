{#
  MOLECULE · callout
  Inline advisory strip. Info tone by default; use for non-blocking diagnostics.

  Params:
    text (string|html, required)
    icon (string) default "info"
    tone (enum: info|accent|warn|bad) default "info"
    action (html) — right slot

  Usage:
    {{ include('components/molecules/callout.html.twig', { text: 'Webhook zwraca 410 od 3 godzin.' }) }}
#}
{%- set toneClass = { info: 'callout', accent: 'auto-detect', warn: 'callout callout--warn', bad: 'feed-card__err' } -%}
<div class="{{ toneClass[tone|default('info')] }}">
  {{ include('components/atoms/icon.html.twig', { name: icon|default('info') }, false) }}
  <span>{{ text|raw }}</span>
  {%- if action is defined %}<span style="margin-left:auto;">{{ action|raw }}</span>{% endif %}
</div>
