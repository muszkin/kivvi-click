{#
  MOLECULE · dropzone
  File drop target. Dashed 2px border; hover fills with accent-soft. Wire drag/drop in upload.ts.

  Params:
    title (string, required)
    sub (string)
    hint (string) — mono line
    accept (string) — input accept attr
    action (string)

  Usage:
    {{ include('components/molecules/dropzone.html.twig', { title: 'Przeciągnij plik tutaj', sub: 'CSV, XML, XLSX · maks. 50 MB' }) }}
#}
<label class="dropzone" data-controller="upload"{% if action is defined %} data-action="{{ action }}"{% endif %}>
  {{ include('components/atoms/icon.html.twig', { name: 'upload' }, false) }}
  <div class="dropzone__title">{{ title }}</div>
  {%- if sub is defined %}<div class="dropzone__sub">{{ sub }}</div>{% endif %}
  {%- if hint is defined %}<div class="dropzone__sub mono">{{ hint }}</div>{% endif %}
  <input type="file" hidden{% if accept is defined %} accept="{{ accept }}"{% endif %} data-upload-target="input">
</label>
