{#
  MOLECULE · card
  Standard surface container. Head/body/foot are all optional; body may be omitted when a table fills the card.

  Params:
    title (string) — head heading
    sub (string) — muted head subtitle
    icon (string) — head icon
    live (bool) — pulsing dot in head
    headActions (html) — right-aligned head slot
    body (html) — padded body slot
    raw (html) — unpadded slot (tables, row lists)
    foot (html) — footer slot
    class (string) — extra classes, e.g. "danger-zone" / "plan-card"

  Usage:
    {{ include('components/molecules/card.html.twig', { title: 'Webhooks', body: '…' }) }}
#}
<div class="card {{ class|default('') }}">
  {%- if title is defined %}
  <div class="card-head">
    {%- if live|default(false) %}{{ include('components/atoms/dot.html.twig', { live: true }, false) }}{% endif %}
    <h3 class="card-title">
      {%- if icon is defined %}{{ include('components/atoms/icon.html.twig', { name: icon }, false) }}{% endif %}
      {{ title }}
    </h3>
    {%- if sub is defined %}<span class="card-sub">{{ sub }}</span>{% endif %}
    {%- if headActions is defined %}<div style="margin-left:auto; display:flex; gap:6px;">{{ headActions|raw }}</div>{% endif %}
  </div>
  {%- endif %}
  {%- if body is defined %}<div class="card-body">{{ body|raw }}</div>{% endif %}
  {%- if raw is defined %}{{ raw|raw }}{% endif %}
  {%- if foot is defined %}<div class="card-foot">{{ foot|raw }}</div>{% endif %}
</div>
