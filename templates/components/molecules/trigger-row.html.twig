{#
  MOLECULE · trigger-row
  Popup trigger line with an optional inline numeric threshold.

  Params:
    label (string, required)
    tone (string)
    value (string) — inline input
    unit (string)
    note (string)

  Usage:
    {{ include('components/molecules/trigger-row.html.twig', { label: 'czas na stronie', value: '20', unit: 'sek.' }) }}
#}
<div class="trig-row">
  {{ include('components/atoms/chip.html.twig', { label: label, tone: tone|default('neutral') }, false) }}
  {%- if value is defined %}<input class="input mono" value="{{ value }}" style="width:60px; padding:3px 6px; font-size:12px;">{% endif %}
  {%- if unit is defined %}<span class="muted" style="font-size:12px;">{{ unit }}</span>{% endif %}
  {%- if note is defined %}<span class="muted" style="font-size:12px;">{{ note }}</span>{% endif %}
  {{ include('components/atoms/button.html.twig', { variant: 'ghost', size: 'sm', icon: 'trash', action: 'remove-trigger' }, false) }}
</div>
