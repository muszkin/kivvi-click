{#
  MOLECULE · event-row
  6-column grid row: time · type icon · type · detail · customer · site. Collapses to 3 columns under 900px. Add class "new" for the 800ms flash-in animation when pushed by Mercure.

  Params:
    time (string, required) — HH:MM:SS
    typeIcon (string, required)
    tone (string) — icon tile tone
    type (string, required) — translated label
    detail (string) — mono metadata
    customerName (string)
    customerId (string) — row click target
    siteName (string)
    siteColor (string)
    isNew (bool)

  Usage:
    {{ include('components/molecules/event-row.html.twig', { time: '14:42:08', typeIcon: 'cart', tone: 'accent', type: 'Dodanie do koszyka' }) }}
#}
<div class="event-row {{ isNew|default(false) ? 'new' : '' }}"
  {%- if customerId is defined %} data-action="go-customer" data-payload="{{ customerId }}"{% endif %}>
  <div class="event-row__time mono">{{ time }}</div>
  <div class="event-row__icon {{ tone|default('') }}">{{ include('components/atoms/icon.html.twig', { name: typeIcon }, false) }}</div>
  <div class="event-row__type">{{ type }}</div>
  <div class="event-row__detail muted">{{ detail|default('') }}</div>
  <div class="event-row__customer">
    {%- if customerName is defined %}
      {{ include('components/atoms/avatar.html.twig', { name: customerName, size: 22 }, false) }}
      <span>{{ customerName }}</span>
    {%- endif %}
  </div>
  <div class="event-row__site">
    {%- if siteName is defined %}
      {{ include('components/atoms/dot.html.twig', { color: siteColor|default('var(--fg-muted)') }, false) }}
      <span class="muted mono" style="font-size:11px;">{{ siteName }}</span>
    {%- endif %}
  </div>
</div>
