{#
  MOLECULE · table
  Data table. Header is sticky; rows highlight on hover. Put it in a card via the `raw` slot so it goes edge to edge.

  Params:
    columns (array of {label,align}) — align "right" for numerics
    rows (array of arrays of cell html) — cells are raw
    rowActions (array) — per-row data-action/data-payload pairs, index-matched
    scroll (bool) — wrap in an overflow-x container (8+ columns)

  Usage:
    {{ include('components/molecules/table.html.twig', { columns: cols, rows: rows }) }}
#}
{%- if scroll|default(false) %}<div style="overflow-x: auto;">{% endif %}
<table class="table">
  <thead>
    <tr>
      {%- for c in columns %}<th{% if c.align|default('') == 'right' %} class="right"{% endif %}>{{ c.label }}</th>{% endfor %}
    </tr>
  </thead>
  <tbody>
    {%- for i, r in rows %}
    <tr{% if rowActions|default([])[i] is defined %} data-action="{{ rowActions[i].action }}" data-payload="{{ rowActions[i].payload }}" style="cursor: pointer;"{% endif %}>
      {%- for cell in r %}<td>{{ cell|raw }}</td>{% endfor %}
    </tr>
    {%- endfor %}
  </tbody>
</table>
{%- if scroll|default(false) %}</div>{% endif %}
