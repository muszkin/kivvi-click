{#
  MOLECULE · filter-chip
  Interactive pill for list filters and segment rails. Active state uses accent-soft + accent border.

  Params:
    label (string, required)
    icon (string)
    dotColor (string) — leading colour dot
    count (int) — appended as " · N"
    active (bool)
    action (string), payload (string)

  Usage:
    {{ include('components/molecules/filter-chip.html.twig', { label: 'VIP', count: 142 }) }}
#}
<button class="filter-chip" data-active="{{ active|default(false) ? 'true' : 'false' }}"
  {%- if action is defined %} data-action="{{ action }}" data-payload="{{ payload|default('') }}"{% endif %}>
  {%- if icon is defined %}{{ include('components/atoms/icon.html.twig', { name: icon }, false) }}{% endif %}
  {%- if dotColor is defined %}{{ include('components/atoms/dot.html.twig', { color: dotColor }, false) }}{% endif %}
  {{ label }}{% if count is defined %} · {{ count|number_format(0, ',', ' ') }}{% endif %}
</button>
