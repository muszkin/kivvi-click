{#
  MOLECULE · map-row
  One row of the import column-mapping table: source column, sample values, target select, confidence. Collapses to a single column under 1100px.

  Params:
    letter (string, required) — spreadsheet column letter
    name (string, required)
    samples (array of string, required)
    targets (array of {value,label}, required)
    mapped (string) — selected target value
    confidence (int) — 0 renders as "—"
    skipped (bool) — 50% opacity row

  Usage:
    {{ include('components/molecules/map-row.html.twig', { letter: 'A', name: 'Adres e-mail', samples: ['a@b.pl'], targets: targets, mapped: 'email', confidence: 99 }) }}
#}
{%- set c = confidence|default(0) -%}
{%- set col = c == 0 ? 'var(--fg-muted)' : (c >= 90 ? 'var(--good)' : (c >= 70 ? 'oklch(0.55 0.10 70)' : 'var(--bad)')) -%}
<div class="map-row" data-skipped="{{ skipped|default(false) ? 'true' : 'false' }}">
  <div class="map-col-name">
    <div class="row" style="gap:8px;">
      <span class="col-letter mono">{{ letter }}</span>
      <strong style="font-size:13px;">{{ name }}</strong>
    </div>
  </div>
  <div class="map-col-sample">
    {%- for s in samples %}<span class="sample-pill mono">{{ s }}</span>{% endfor %}
  </div>
  <div class="map-col-target">
    <select class="select" name="map[{{ letter }}]">
      {%- for t in targets %}<option value="{{ t.value }}"{{ t.value == mapped|default('') ? ' selected' : '' }}>{{ t.label }}</option>{% endfor %}
    </select>
  </div>
  <div class="map-col-conf right">
    {%- if c > 0 %}<span class="mono" style="color: {{ col }}; font-weight:500;">{{ c }}%</span>
    {%- else %}<span class="muted mono">—</span>{% endif %}
  </div>
</div>
