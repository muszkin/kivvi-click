{#
  MOLECULE · add-slot
  Dashed "add another" affordance. Turns accent on hover.

  Params:
    label (string, required)
    action (string)
    payload (string)

  Usage:
    {{ include('components/molecules/add-slot.html.twig', { label: 'Dodaj krok', action: 'add-step' }) }}
#}
<button class="rb-add"{% if action is defined %} data-action="{{ action }}"{% endif %}{% if payload is defined %} data-payload="{{ payload }}"{% endif %}>
  {{ include('components/atoms/icon.html.twig', { name: 'plus' }, false) }} {{ label }}
</button>
