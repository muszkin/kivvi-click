{
    "name": "kivvi-click-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "test": "vitest run test/unit",
        "test:integration": "vitest run test/integration",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "pinia": "4.0.3",
        "vue": "3.5.42",
        "vue-i18n": "11.4.10",
        "vue-router": "5.3.1"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.5.0",
        "@vitejs/plugin-vue": "6.0.8",
        "@vue/test-utils": "2.5.0",
        "eslint": "10.10.0",
        "eslint-plugin-vue": "10.11.0",
        "globals": "17.12.0",
        "jsdom": "30.0.1",
        "prettier": "3.8.4",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.0",
        "vite": "8.2.2",
        "vitest": "5.0.0",
        "vue-tsc": "3.3.11"
    }
}
